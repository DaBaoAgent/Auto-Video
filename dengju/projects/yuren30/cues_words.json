{
 "clauses": [
  {
   "p": 0,
   "j": 0,
   "text": "一九八三年，",
   "t0": 0.0,
   "t1": 0.62
  },
  {
   "p": 0,
   "j": 1,
   "text": "广州工人在象岗山一铲子挖出一只黑匣子。",
   "t0": 0.74,
   "t1": 3.5900000000000003
  },
  {
   "p": 0,
   "j": 2,
   "text": "里面装着非洲象牙、",
   "t0": 3.5900000000000003,
   "t1": 4.88
  },
  {
   "p": 0,
   "j": 3,
   "text": "波斯药盒、",
   "t0": 4.9,
   "t1": 5.66
  },
  {
   "p": 0,
   "j": 4,
   "text": "两公斤矿石药，",
   "t0": 5.72,
   "t1": 6.74
  },
  {
   "p": 0,
   "j": 5,
   "text": "还有一套能把人封进玉石里的衣服。",
   "t0": 6.74,
   "t1": 8.83
  },
  {
   "p": 0,
   "j": 6,
   "text": "顺着线索往南，",
   "t0": 8.83,
   "t1": 9.84
  },
  {
   "p": 0,
   "j": 7,
   "text": "最后会撞进南极冰盖下一条消失了几千万年的河。",
   "t0": 9.84,
   "t1": 13.16
  },
  {
   "p": 1,
   "j": 0,
   "text": "那年六月，",
   "t0": 13.38,
   "t1": 13.969999999999999
  },
  {
   "p": 1,
   "j": 1,
   "text": "象岗山已经被削了三年，",
   "t0": 13.969999999999999,
   "t1": 15.88
  },
  {
   "p": 1,
   "j": 2,
   "text": "将近五十米的山头只剩三十多米。",
   "t0": 15.88,
   "t1": 18.32
  },
  {
   "p": 1,
   "j": 3,
   "text": "工人们给宿舍挖墙基时，",
   "t0": 18.32,
   "t1": 19.94
  },
  {
   "p": 1,
   "j": 4,
   "text": "铁锹下面突然露出一排平整石板，",
   "t0": 19.94,
   "t1": 22.31
  },
  {
   "p": 1,
   "j": 5,
   "text": "顺着石缝往下照，",
   "t0": 22.31,
   "t1": 23.48
  },
  {
   "p": 1,
   "j": 6,
   "text": "里面黑得没有底。",
   "t0": 23.48,
   "t1": 24.349999999999998
  },
  {
   "p": 1,
   "j": 7,
   "text": "四十三天后，",
   "t0": 24.349999999999998,
   "t1": 25.41
  },
  {
   "p": 1,
   "j": 8,
   "text": "七间石室、",
   "t0": 25.41,
   "t1": 26.377
  },
  {
   "p": 1,
   "j": 9,
   "text": "一万多件文物和十五个殉人一起重见天日。",
   "t0": 26.377,
   "t1": 29.34
  },
  {
   "p": 1,
   "j": 10,
   "text": "考古队最后认出的墓主，",
   "t0": 29.38,
   "t1": 30.83
  },
  {
   "p": 1,
   "j": 11,
   "text": "不是赵佗，",
   "t0": 30.83,
   "t1": 31.57
  },
  {
   "p": 1,
   "j": 12,
   "text": "而是他的孙子赵眜。",
   "t0": 31.57,
   "t1": 32.870000000000005
  },
  {
   "p": 1,
   "j": 13,
   "text": "爷爷没找到，",
   "t0": 32.870000000000005,
   "t1": 33.77
  },
  {
   "p": 1,
   "j": 14,
   "text": "孙子先出土；",
   "t0": 33.77,
   "t1": 34.84
  },
  {
   "p": 1,
   "j": 15,
   "text": "如果赵眜只是守陵人，",
   "t0": 34.84,
   "t1": 36.52
  },
  {
   "p": 1,
   "j": 16,
   "text": "赵佗的王座会不会还在越秀山下？",
   "t0": 36.52,
   "t1": 38.86
  },
  {
   "p": 2,
   "j": 0,
   "text": "博物院写得很清楚，",
   "t0": 39.06,
   "t1": 40.08
  },
  {
   "p": 2,
   "j": 1,
   "text": "墓室藏在地下大约二十米，",
   "t0": 40.34,
   "t1": 42.28
  },
  {
   "p": 2,
   "j": 2,
   "text": "平面像个士字，",
   "t0": 42.32,
   "t1": 43.343
  },
  {
   "p": 2,
   "j": 3,
   "text": "南北十点八五米，",
   "t0": 43.343,
   "t1": 44.48
  },
  {
   "p": 2,
   "j": 4,
   "text": "东西最宽十二点五米，",
   "t0": 44.5,
   "t1": 45.92
  },
  {
   "p": 2,
   "j": 5,
   "text": "总面积约一百平方米。",
   "t0": 45.92,
   "t1": 47.36
  },
  {
   "p": 2,
   "j": 6,
   "text": "里面分成七间，",
   "t0": 47.36,
   "t1": 48.64
  },
  {
   "p": 2,
   "j": 7,
   "text": "前朝后寝，",
   "t0": 48.64,
   "t1": 49.470000000000006
  },
  {
   "p": 2,
   "j": 8,
   "text": "王宫怎么分，",
   "t0": 49.470000000000006,
   "t1": 50.26
  },
  {
   "p": 2,
   "j": 9,
   "text": "地下就怎么分。",
   "t0": 50.32,
   "t1": 51.330000000000005
  },
  {
   "p": 2,
   "j": 10,
   "text": "七百五十多块红砂岩还从几十海里外的番禺莲花山运来，",
   "t0": 51.330000000000005,
   "t1": 55.13
  },
  {
   "p": 2,
   "j": 11,
   "text": "挖运土石超过三千立方米。",
   "t0": 55.13,
   "t1": 56.970000000000006
  },
  {
   "p": 2,
   "j": 12,
   "text": "没有机械，",
   "t0": 56.970000000000006,
   "t1": 57.6
  },
  {
   "p": 2,
   "j": 13,
   "text": "却在城边掏出一座地下王宫。",
   "t0": 57.62,
   "t1": 59.49
  },
  {
   "p": 2,
   "j": 14,
   "text": "这到底是在安葬死人，",
   "t0": 59.49,
   "t1": 61.08
  },
  {
   "p": 2,
   "j": 15,
   "text": "还是在给某个灵魂准备一个可以重新启动的王国？",
   "t0": 61.12,
   "t1": 64.32
  },
  {
   "p": 3,
   "j": 0,
   "text": "墓里出土一千多套、",
   "t0": 64.38,
   "t1": 65.8
  },
  {
   "p": 3,
   "j": 1,
   "text": "上万件文物，",
   "t0": 65.84,
   "t1": 66.98
  },
  {
   "p": 3,
   "j": 2,
   "text": "金玉铜铁、",
   "t0": 67.06,
   "t1": 67.82
  },
  {
   "p": 3,
   "j": 3,
   "text": "象牙玻璃、",
   "t0": 67.86,
   "t1": 68.75
  },
  {
   "p": 3,
   "j": 4,
   "text": "香料武器，",
   "t0": 68.75,
   "t1": 69.58
  },
  {
   "p": 3,
   "j": 5,
   "text": "什么都有。",
   "t0": 69.58,
   "t1": 70.14
  },
  {
   "p": 3,
   "j": 6,
   "text": "更扎眼的是十五个殉人，",
   "t0": 70.28,
   "t1": 72.02
  },
  {
   "p": 3,
   "j": 7,
   "text": "数量在同时期王侯墓里都罕见。",
   "t0": 72.02,
   "t1": 74.44
  },
  {
   "p": 3,
   "j": 8,
   "text": "有人做饭，",
   "t0": 74.48,
   "t1": 75.16
  },
  {
   "p": 3,
   "j": 9,
   "text": "有人守武器，",
   "t0": 75.18,
   "t1": 76.08
  },
  {
   "p": 3,
   "j": 10,
   "text": "有人陪在身边，",
   "t0": 76.08,
   "t1": 77.0
  },
  {
   "p": 3,
   "j": 11,
   "text": "像一支在黑暗里待命的队伍。",
   "t0": 77.0,
   "t1": 78.83
  },
  {
   "p": 3,
   "j": 12,
   "text": "若这真是一座空着的王座，",
   "t0": 78.83,
   "t1": 80.56
  },
  {
   "p": 3,
   "j": 13,
   "text": "他们等的那位主人，",
   "t0": 80.56,
   "t1": 81.79
  },
  {
   "p": 3,
   "j": 14,
   "text": "会不会在两千年后回来？",
   "t0": 81.79,
   "t1": 83.32
  },
  {
   "p": 4,
   "j": 0,
   "text": "赵眜身上穿的，",
   "t0": 83.34,
   "t1": 84.51
  },
  {
   "p": 4,
   "j": 1,
   "text": "是丝缕玉衣。",
   "t0": 84.51,
   "t1": 85.78
  },
  {
   "p": 4,
   "j": 2,
   "text": "玉片拼成人的身体，",
   "t0": 85.78,
   "t1": 87.04
  },
  {
   "p": 4,
   "j": 3,
   "text": "用丝线编缀，",
   "t0": 87.06,
   "t1": 88.07000000000001
  },
  {
   "p": 4,
   "j": 4,
   "text": "是目前我国发现的唯一一套形制完备的丝缕玉衣。",
   "t0": 88.07000000000001,
   "t1": 91.55
  },
  {
   "p": 4,
   "j": 5,
   "text": "最高等级的玉衣用金线串玉片，",
   "t0": 91.55,
   "t1": 93.94
  },
  {
   "p": 4,
   "j": 6,
   "text": "金子几乎不会烂，",
   "t0": 93.94,
   "t1": 95.04
  },
  {
   "p": 4,
   "j": 7,
   "text": "丝线却会。",
   "t0": 95.1,
   "t1": 95.99000000000001
  },
  {
   "p": 4,
   "j": 8,
   "text": "赵眜的玉衣出土时只剩一地玉片，",
   "t0": 95.99000000000001,
   "t1": 98.32
  },
  {
   "p": 4,
   "j": 9,
   "text": "金线一根都没有，",
   "t0": 98.36,
   "t1": 99.4
  },
  {
   "p": 4,
   "j": 10,
   "text": "像一张皇帝身份证被撕掉了最重要的印章。",
   "t0": 99.48,
   "t1": 102.41
  },
  {
   "p": 4,
   "j": 11,
   "text": "金线消失得太干净，",
   "t0": 102.41,
   "t1": 103.76
  },
  {
   "p": 4,
   "j": 12,
   "text": "反倒像有人故意把最高身份从尸体上抽走了。",
   "t0": 103.76,
   "t1": 106.74
  },
  {
   "p": 4,
   "j": 13,
   "text": "也许赵眜故意用降级玉衣做伪装，",
   "t0": 106.84,
   "t1": 109.04
  },
  {
   "p": 4,
   "j": 14,
   "text": "他的升格要等死亡以后。",
   "t0": 109.04,
   "t1": 110.96
  },
  {
   "p": 5,
   "j": 0,
   "text": "可他又偏偏自称皇帝。",
   "t0": 110.98,
   "t1": 112.64
  },
  {
   "p": 5,
   "j": 1,
   "text": "胸前出土一枚龙钮金印，",
   "t0": 112.7,
   "t1": 114.56
  },
  {
   "p": 5,
   "j": 2,
   "text": "四个字，",
   "t0": 114.56,
   "t1": 115.12
  },
  {
   "p": 5,
   "j": 3,
   "text": "文帝行玺，",
   "t0": 115.12,
   "t1": 116.01
  },
  {
   "p": 5,
   "j": 4,
   "text": "含金量高达百分之九十八，",
   "t0": 116.01,
   "t1": 117.659
  },
  {
   "p": 5,
   "j": 5,
   "text": "是所见最大的西汉金印。",
   "t0": 117.659,
   "t1": 119.31
  },
  {
   "p": 5,
   "j": 6,
   "text": "一个向汉朝称臣的南越王，",
   "t0": 119.31,
   "t1": 121.0
  },
  {
   "p": 5,
   "j": 7,
   "text": "活着时向北方低头，",
   "t0": 121.02,
   "t1": 122.38
  },
  {
   "p": 5,
   "j": 8,
   "text": "死后把皇帝身份压在胸口。",
   "t0": 122.4,
   "t1": 124.32
  },
  {
   "p": 5,
   "j": 9,
   "text": "一个人为什么需要两张脸？",
   "t0": 124.36,
   "t1": 125.99000000000001
  },
  {
   "p": 5,
   "j": 10,
   "text": "也许躺进地宫以后，",
   "t0": 125.99000000000001,
   "t1": 127.34
  },
  {
   "p": 5,
   "j": 11,
   "text": "赵眜才敢做南越文帝。",
   "t0": 127.36,
   "t1": 128.92
  },
  {
   "p": 6,
   "j": 0,
   "text": "墓里一共出了二十三枚玺印，",
   "t0": 128.92,
   "t1": 130.81
  },
  {
   "p": 6,
   "j": 1,
   "text": "名字、",
   "t0": 130.81,
   "t1": 131.3
  },
  {
   "p": 6,
   "j": 2,
   "text": "身份、",
   "t0": 131.34,
   "t1": 131.92999999999998
  },
  {
   "p": 6,
   "j": 3,
   "text": "等级全刻在方寸之间，",
   "t0": 131.92999999999998,
   "t1": 133.67
  },
  {
   "p": 6,
   "j": 4,
   "text": "像一座地下朝廷的整套公章。",
   "t0": 133.67,
   "t1": 135.53699999999998
  },
  {
   "p": 6,
   "j": 5,
   "text": "赵眜造的不只是墓，",
   "t0": 135.53699999999998,
   "t1": 136.7
  },
  {
   "p": 6,
   "j": 6,
   "text": "还像一套能继续运转的地下王国。",
   "t0": 136.76,
   "t1": 139.34
  },
  {
   "p": 6,
   "j": 7,
   "text": "玉衣、",
   "t0": 139.46,
   "t1": 139.96
  },
  {
   "p": 6,
   "j": 8,
   "text": "玺印、",
   "t0": 139.98,
   "t1": 140.6
  },
  {
   "p": 6,
   "j": 9,
   "text": "厨房、",
   "t0": 140.8,
   "t1": 141.32
  },
  {
   "p": 6,
   "j": 10,
   "text": "武器和殉人，",
   "t0": 141.44,
   "t1": 142.4
  },
  {
   "p": 6,
   "j": 11,
   "text": "全都各司其职。",
   "t0": 142.4,
   "t1": 143.48
  },
  {
   "p": 6,
   "j": 12,
   "text": "如果每一枚印都能打开一扇门，",
   "t0": 143.48,
   "t1": 145.46
  },
  {
   "p": 6,
   "j": 13,
   "text": "这座墓里锁着的，",
   "t0": 145.52,
   "t1": 146.63
  },
  {
   "p": 6,
   "j": 14,
   "text": "会不会是一整套早已消失的政权备份？",
   "t0": 146.63,
   "t1": 149.03699999999998
  },
  {
   "p": 7,
   "j": 0,
   "text": "玉衣下面，",
   "t0": 149.03699999999998,
   "t1": 149.74
  },
  {
   "p": 7,
   "j": 1,
   "text": "考古队又挖出一组五色药石。",
   "t0": 149.96,
   "t1": 151.96
  },
  {
   "p": 7,
   "j": 2,
   "text": "紫水晶、",
   "t0": 152.0,
   "t1": 152.76
  },
  {
   "p": 7,
   "j": 3,
   "text": "绿松石、",
   "t0": 152.82,
   "t1": 153.54
  },
  {
   "p": 7,
   "j": 4,
   "text": "雄黄、",
   "t0": 153.76,
   "t1": 154.26
  },
  {
   "p": 7,
   "j": 5,
   "text": "硫磺和赭石加起来大约两公斤，",
   "t0": 154.44,
   "t1": 156.5
  },
  {
   "p": 7,
   "j": 6,
   "text": "其中雄黄就有一千一百三十克。",
   "t0": 156.52,
   "t1": 158.39
  },
  {
   "p": 7,
   "j": 7,
   "text": "馆方说，",
   "t0": 158.39,
   "t1": 159.06
  },
  {
   "p": 7,
   "j": 8,
   "text": "古人把它们当成延年益寿的五石散。",
   "t0": 159.14,
   "t1": 161.6
  },
  {
   "p": 7,
   "j": 9,
   "text": "五色刚好对应五行，",
   "t0": 161.62,
   "t1": 162.98
  },
  {
   "p": 7,
   "j": 10,
   "text": "难道这些药是在给灵魂重新拼一具身体？",
   "t0": 163.06,
   "t1": 166.02
  },
  {
   "p": 8,
   "j": 0,
   "text": "玉片旁边还有一只铜承盘高足玉杯，",
   "t0": 166.08,
   "t1": 168.67
  },
  {
   "p": 8,
   "j": 1,
   "text": "用了金、",
   "t0": 168.67,
   "t1": 169.3
  },
  {
   "p": 8,
   "j": 2,
   "text": "银、",
   "t0": 169.32,
   "t1": 169.62
  },
  {
   "p": 8,
   "j": 3,
   "text": "玉、",
   "t0": 169.72,
   "t1": 170.02
  },
  {
   "p": 8,
   "j": 4,
   "text": "铜、",
   "t0": 170.16,
   "t1": 170.46
  },
  {
   "p": 8,
   "j": 5,
   "text": "木五种材料，",
   "t0": 170.5,
   "t1": 171.6
  },
  {
   "p": 8,
   "j": 6,
   "text": "三只金龙银身托着玉杯，",
   "t0": 171.6,
   "t1": 173.45
  },
  {
   "p": 8,
   "j": 7,
   "text": "杯下是铜盘。",
   "t0": 173.45,
   "t1": 174.36
  },
  {
   "p": 8,
   "j": 8,
   "text": "赵眜究竟拿它喝过什么，",
   "t0": 174.38,
   "t1": 175.8
  },
  {
   "p": 8,
   "j": 9,
   "text": "没人知道。",
   "t0": 175.86,
   "t1": 176.66
  },
  {
   "p": 8,
   "j": 10,
   "text": "五色药石配五材玉杯，",
   "t0": 176.96,
   "t1": 178.69
  },
  {
   "p": 8,
   "j": 11,
   "text": "怎么看都不像随手摆的陪葬品，",
   "t0": 178.69,
   "t1": 180.64
  },
  {
   "p": 8,
   "j": 12,
   "text": "更像一套步骤严格的炼化装置。",
   "t0": 180.64,
   "t1": 182.68
  },
  {
   "p": 8,
   "j": 13,
   "text": "也许古人相信，",
   "t0": 182.68,
   "t1": 183.56
  },
  {
   "p": 8,
   "j": 14,
   "text": "喝下去的不是药，",
   "t0": 183.74,
   "t1": 184.86
  },
  {
   "p": 8,
   "j": 15,
   "text": "是一段能留住灵魂的咒。",
   "t0": 185.0,
   "t1": 186.70999999999998
  },
  {
   "p": 9,
   "j": 0,
   "text": "更有意思的是那只蒜头形银盒。",
   "t0": 186.70999999999998,
   "t1": 189.14
  },
  {
   "p": 9,
   "j": 1,
   "text": "它用锤鍱法打出交错凸瓣纹，",
   "t0": 189.14,
   "t1": 191.48
  },
  {
   "p": 9,
   "j": 2,
   "text": "造型完全不像中国传统容器，",
   "t0": 191.54,
   "t1": 193.42
  },
  {
   "p": 9,
   "j": 3,
   "text": "工艺能追到古波斯阿契美尼德王朝。",
   "t0": 193.52,
   "t1": 196.10999999999999
  },
  {
   "p": 9,
   "j": 4,
   "text": "银盒来到南越后，",
   "t0": 196.10999999999999,
   "t1": 197.28
  },
  {
   "p": 9,
   "j": 5,
   "text": "又被加了鎏金铜圈足，",
   "t0": 197.28,
   "t1": 198.82999999999998
  },
  {
   "p": 9,
   "j": 6,
   "text": "刻上汉字铭文。",
   "t0": 198.82999999999998,
   "t1": 199.86
  },
  {
   "p": 9,
   "j": 7,
   "text": "波斯药盒被中国人加底座、",
   "t0": 199.86,
   "t1": 201.92999999999998
  },
  {
   "p": 9,
   "j": 8,
   "text": "刻汉字，",
   "t0": 201.92999999999998,
   "t1": 202.62
  },
  {
   "p": 9,
   "j": 9,
   "text": "当成自己的器物继续用。",
   "t0": 202.62,
   "t1": 204.29
  },
  {
   "p": 9,
   "j": 10,
   "text": "它为什么会被带进王陵？",
   "t0": 204.29,
   "t1": 205.73
  },
  {
   "p": 9,
   "j": 11,
   "text": "难道里面装的是外国使团送来的长生处方？",
   "t0": 205.73,
   "t1": 208.19
  },
  {
   "p": 10,
   "j": 0,
   "text": "盒里的药丸早已碳化，",
   "t0": 208.19,
   "t1": 209.68
  },
  {
   "p": 10,
   "j": 1,
   "text": "化验不出配方。",
   "t0": 209.72,
   "t1": 210.84
  },
  {
   "p": 10,
   "j": 2,
   "text": "最关键的药方，",
   "t0": 210.88,
   "t1": 211.92999999999998
  },
  {
   "p": 10,
   "j": 3,
   "text": "偏偏就在历史里蒸发了。",
   "t0": 211.92999999999998,
   "t1": 213.51
  },
  {
   "p": 10,
   "j": 4,
   "text": "玉杯、",
   "t0": 213.51,
   "t1": 213.92
  },
  {
   "p": 10,
   "j": 5,
   "text": "药石、",
   "t0": 213.98,
   "t1": 214.7
  },
  {
   "p": 10,
   "j": 6,
   "text": "银盒摆在一起，",
   "t0": 214.8,
   "t1": 215.81
  },
  {
   "p": 10,
   "j": 7,
   "text": "赵眜追求的不只是活得久，",
   "t0": 215.81,
   "t1": 217.54
  },
  {
   "p": 10,
   "j": 8,
   "text": "他像在调动整个南越国最稀奇的材料，",
   "t0": 217.54,
   "t1": 220.18
  },
  {
   "p": 10,
   "j": 9,
   "text": "替自己完成一场跨越生死的实验。",
   "t0": 220.18,
   "t1": 222.5
  },
  {
   "p": 10,
   "j": 10,
   "text": "也许那张没找到的配方，",
   "t0": 222.5,
   "t1": 223.94
  },
  {
   "p": 10,
   "j": 11,
   "text": "比一箱黄金还值钱。",
   "t0": 223.94,
   "t1": 225.28
  },
  {
   "p": 11,
   "j": 0,
   "text": "南越王墓还出土了近四十枚焊珠金花泡，",
   "t0": 225.34,
   "t1": 228.35999999999999
  },
  {
   "p": 11,
   "j": 1,
   "text": "直径只有一点一厘米。",
   "t0": 228.35999999999999,
   "t1": 229.69
  },
  {
   "p": 11,
   "j": 2,
   "text": "它们小得像纽扣，",
   "t0": 229.69,
   "t1": 230.78
  },
  {
   "p": 11,
   "j": 3,
   "text": "表面却用金丝和金珠焊出圆形、",
   "t0": 230.78,
   "t1": 232.94
  },
  {
   "p": 11,
   "j": 4,
   "text": "心形、",
   "t0": 233.02,
   "t1": 233.527
  },
  {
   "p": 11,
   "j": 5,
   "text": "辫索形图案，",
   "t0": 233.527,
   "t1": 234.60999999999999
  },
  {
   "p": 11,
   "j": 6,
   "text": "放大二十倍才能看清接缝。",
   "t0": 234.60999999999999,
   "t1": 236.48999999999998
  },
  {
   "p": 11,
   "j": 7,
   "text": "这种工艺最早出现在两河流域，",
   "t0": 236.48999999999998,
   "t1": 238.47
  },
  {
   "p": 11,
   "j": 8,
   "text": "后来流行于古埃及、",
   "t0": 238.47,
   "t1": 239.84
  },
  {
   "p": 11,
   "j": 9,
   "text": "克里特和波斯，",
   "t0": 239.84,
   "t1": 240.92
  },
  {
   "p": 11,
   "j": 10,
   "text": "又传到印度。",
   "t0": 240.92,
   "t1": 241.78
  },
  {
   "p": 11,
   "j": 11,
   "text": "每一颗金珠都像一枚微型芯片，",
   "t0": 241.78,
   "t1": 243.88
  },
  {
   "p": 11,
   "j": 12,
   "text": "存着一条横跨西亚、",
   "t0": 243.88,
   "t1": 245.32
  },
  {
   "p": 11,
   "j": 13,
   "text": "埃及和印度的技术路线。",
   "t0": 245.34,
   "t1": 246.96
  },
  {
   "p": 11,
   "j": 14,
   "text": "四十枚凑在一起，",
   "t0": 247.08,
   "t1": 248.08
  },
  {
   "p": 11,
   "j": 15,
   "text": "会不会是一张只有王族才看得懂的航海导航图？",
   "t0": 248.2,
   "t1": 251.56
  },
  {
   "p": 12,
   "j": 0,
   "text": "央视考古节目还确认了两件事。",
   "t0": 251.76,
   "t1": 253.72
  },
  {
   "p": 12,
   "j": 1,
   "text": "西耳室出土的象牙来自非洲象，",
   "t0": 253.82,
   "t1": 255.88
  },
  {
   "p": 12,
   "j": 2,
   "text": "另一个漆盒里保存着二十六克乳香，",
   "t0": 255.88,
   "t1": 258.18
  },
  {
   "p": 12,
   "j": 3,
   "text": "来源指向红海沿岸的阿拉伯地区。",
   "t0": 258.18,
   "t1": 260.38
  },
  {
   "p": 12,
   "j": 4,
   "text": "非洲象牙、",
   "t0": 260.38,
   "t1": 261.4
  },
  {
   "p": 12,
   "j": 5,
   "text": "红海乳香、",
   "t0": 261.44,
   "t1": 262.44
  },
  {
   "p": 12,
   "j": 6,
   "text": "波斯银盒、",
   "t0": 262.44,
   "t1": 263.39
  },
  {
   "p": 12,
   "j": 7,
   "text": "西亚金珠，",
   "t0": 263.39,
   "t1": 264.22999999999996
  },
  {
   "p": 12,
   "j": 8,
   "text": "全都躺在南越王墓里。",
   "t0": 264.22999999999996,
   "t1": 265.77
  },
  {
   "p": 12,
   "j": 9,
   "text": "乍看是奇珍异宝，",
   "t0": 265.77,
   "t1": 266.92
  },
  {
   "p": 12,
   "j": 10,
   "text": "换个角度，",
   "t0": 266.92,
   "t1": 267.7
  },
  {
   "p": 12,
   "j": 11,
   "text": "就是一张两千年前的国际物流单。",
   "t0": 267.7,
   "t1": 269.84
  },
  {
   "p": 12,
   "j": 12,
   "text": "有货单，",
   "t0": 269.9,
   "t1": 270.52
  },
  {
   "p": 12,
   "j": 13,
   "text": "就得有发货人、",
   "t0": 270.52,
   "t1": 271.6
  },
  {
   "p": 12,
   "j": 14,
   "text": "收货人和路线。",
   "t0": 271.6,
   "t1": 273.06
  },
  {
   "p": 12,
   "j": 15,
   "text": "可南越王墓里偏偏没有完整地图，",
   "t0": 273.06,
   "t1": 275.22
  },
  {
   "p": 12,
   "j": 16,
   "text": "难道路线被人故意拆散，",
   "t0": 275.28,
   "t1": 276.9
  },
  {
   "p": 12,
   "j": 17,
   "text": "藏进了每件货物里？",
   "t0": 276.9,
   "t1": 278.18
  },
  {
   "p": 13,
   "j": 0,
   "text": "赵眜的地下王国，",
   "t0": 278.18,
   "t1": 279.25
  },
  {
   "p": 13,
   "j": 1,
   "text": "不只搬进了半个古代世界，",
   "t0": 279.25,
   "t1": 280.92
  },
  {
   "p": 13,
   "j": 2,
   "text": "还把一条贸易网压成了一批可以随身携带的物证。",
   "t0": 281.1,
   "t1": 284.13
  },
  {
   "p": 13,
   "j": 3,
   "text": "谁能收到象牙和乳香，",
   "t0": 284.13,
   "t1": 285.7
  },
  {
   "p": 13,
   "j": 4,
   "text": "谁就一定知道海那边还有人。",
   "t0": 285.7,
   "t1": 287.46
  },
  {
   "p": 13,
   "j": 5,
   "text": "问题是，",
   "t0": 287.52,
   "t1": 288.06
  },
  {
   "p": 13,
   "j": 6,
   "text": "货到了广州以后，",
   "t0": 288.1,
   "t1": 289.28
  },
  {
   "p": 13,
   "j": 7,
   "text": "究竟是谁替这位国王继续往南走？",
   "t0": 289.28,
   "t1": 291.48
  },
  {
   "p": 14,
   "j": 0,
   "text": "线索落在百越身上。",
   "t0": 291.62,
   "t1": 292.94
  },
  {
   "p": 14,
   "j": 1,
   "text": "百越不是整齐的民族，",
   "t0": 292.96,
   "t1": 294.32
  },
  {
   "p": 14,
   "j": 2,
   "text": "更像一大片共享水网、",
   "t0": 294.32,
   "t1": 296.0
  },
  {
   "p": 14,
   "j": 3,
   "text": "语言和习俗的南方人群，",
   "t0": 296.02,
   "t1": 297.78
  },
  {
   "p": 14,
   "j": 4,
   "text": "分布在广东、",
   "t0": 297.82,
   "t1": 298.74
  },
  {
   "p": 14,
   "j": 5,
   "text": "广西、",
   "t0": 298.74,
   "t1": 299.32
  },
  {
   "p": 14,
   "j": 6,
   "text": "贵州、",
   "t0": 299.38,
   "t1": 299.98
  },
  {
   "p": 14,
   "j": 7,
   "text": "云南、",
   "t0": 300.06,
   "t1": 300.62
  },
  {
   "p": 14,
   "j": 8,
   "text": "越南和东南亚。",
   "t0": 300.62,
   "t1": 301.92
  },
  {
   "p": 14,
   "j": 9,
   "text": "对北方军队来说，",
   "t0": 301.92,
   "t1": 303.12
  },
  {
   "p": 14,
   "j": 10,
   "text": "岭南是山和瘴气；",
   "t0": 303.22,
   "t1": 304.5
  },
  {
   "p": 14,
   "j": 11,
   "text": "对百越来说，",
   "t0": 304.5,
   "t1": 305.32
  },
  {
   "p": 14,
   "j": 12,
   "text": "河流就是高速公路，",
   "t0": 305.36,
   "t1": 306.86
  },
  {
   "p": 14,
   "j": 13,
   "text": "船就是战马。",
   "t0": 306.86,
   "t1": 307.71
  },
  {
   "p": 14,
   "j": 14,
   "text": "若岭南真是森林和瘴气，",
   "t0": 307.71,
   "t1": 309.36
  },
  {
   "p": 14,
   "j": 15,
   "text": "那些非洲货又是怎么越过山海进来的？",
   "t0": 309.36,
   "t1": 311.93
  },
  {
   "p": 15,
   "j": 0,
   "text": "《史记》里有个很像谍战片的故事。",
   "t0": 311.93,
   "t1": 313.88
  },
  {
   "p": 15,
   "j": 1,
   "text": "汉武帝派唐蒙出使南越，",
   "t0": 313.88,
   "t1": 315.74
  },
  {
   "p": 15,
   "j": 2,
   "text": "唐蒙到了当地不急着谈正事，",
   "t0": 315.74,
   "t1": 317.86
  },
  {
   "p": 15,
   "j": 3,
   "text": "先到处吃。",
   "t0": 317.9,
   "t1": 318.74
  },
  {
   "p": 15,
   "j": 4,
   "text": "他吃到一种四川来的酱，",
   "t0": 318.74,
   "t1": 320.19
  },
  {
   "p": 15,
   "j": 5,
   "text": "立刻反应过来，",
   "t0": 320.19,
   "t1": 321.22
  },
  {
   "p": 15,
   "j": 6,
   "text": "四川和广州之间藏着一条朝廷不知道的水路。",
   "t0": 321.26,
   "t1": 324.3
  },
  {
   "p": 15,
   "j": 7,
   "text": "唐蒙故意装傻，",
   "t0": 324.3,
   "t1": 325.34
  },
  {
   "p": 15,
   "j": 8,
   "text": "说这不可能，",
   "t0": 325.34,
   "t1": 326.14
  },
  {
   "p": 15,
   "j": 9,
   "text": "对方一急，",
   "t0": 326.32,
   "t1": 327.0
  },
  {
   "p": 15,
   "j": 10,
   "text": "把路线也交代了。",
   "t0": 327.0,
   "t1": 328.18
  },
  {
   "p": 15,
   "j": 11,
   "text": "一勺酱，",
   "t0": 328.18,
   "t1": 328.86
  },
  {
   "p": 15,
   "j": 12,
   "text": "捅穿了南越守了多年的山脉和关隘。",
   "t0": 328.86,
   "t1": 331.25
  },
  {
   "p": 15,
   "j": 13,
   "text": "若一罐酱就能泄露一条军路，",
   "t0": 331.25,
   "t1": 333.04
  },
  {
   "p": 15,
   "j": 14,
   "text": "那些象牙、",
   "t0": 333.04,
   "t1": 333.88
  },
  {
   "p": 15,
   "j": 15,
   "text": "乳香和金珠背后，",
   "t0": 333.88,
   "t1": 335.2
  },
  {
   "p": 15,
   "j": 16,
   "text": "会不会还藏着一条更长的秘密航路？",
   "t0": 335.22,
   "t1": 337.43
  },
  {
   "p": 16,
   "j": 0,
   "text": "二零二三年的一项学术研究，",
   "t0": 337.43,
   "t1": 339.34
  },
  {
   "p": 16,
   "j": 1,
   "text": "把岭南沿海放进一张复杂的水上网络。",
   "t0": 339.36,
   "t1": 341.93
  },
  {
   "p": 16,
   "j": 2,
   "text": "珠江、",
   "t0": 341.93,
   "t1": 342.36
  },
  {
   "p": 16,
   "j": 3,
   "text": "红河、",
   "t0": 342.5,
   "t1": 343.06
  },
  {
   "p": 16,
   "j": 4,
   "text": "沿海航线和内陆河道互相咬合，",
   "t0": 343.14,
   "t1": 345.64
  },
  {
   "p": 16,
   "j": 5,
   "text": "商品可能经过许多中间人转手，",
   "t0": 345.76,
   "t1": 347.78
  },
  {
   "p": 16,
   "j": 6,
   "text": "未必每件都由广州船队直接开到非洲。",
   "t0": 347.78,
   "t1": 350.48
  },
  {
   "p": 16,
   "j": 7,
   "text": "但也正因为中间人太多，",
   "t0": 350.48,
   "t1": 351.92
  },
  {
   "p": 16,
   "j": 8,
   "text": "广州可能只是终点站之一。",
   "t0": 351.98,
   "t1": 353.76
  },
  {
   "p": 16,
   "j": 9,
   "text": "更早的中转港、",
   "t0": 353.76,
   "t1": 354.86
  },
  {
   "p": 16,
   "j": 10,
   "text": "仓库和航线，",
   "t0": 354.86,
   "t1": 356.03
  },
  {
   "p": 16,
   "j": 11,
   "text": "会不会已经被海水抹平了？",
   "t0": 356.03,
   "t1": 357.71
  },
  {
   "p": 17,
   "j": 0,
   "text": "二零二二年，",
   "t0": 357.71,
   "t1": 358.56
  },
  {
   "p": 17,
   "j": 1,
   "text": "中国又在南海西北陆坡约一千五百米深处发现两艘明代沉船。",
   "t0": 358.64,
   "t1": 362.84
  },
  {
   "p": 17,
   "j": 2,
   "text": "到二零二四年，",
   "t0": 362.84,
   "t1": 363.76
  },
  {
   "p": 17,
   "j": 3,
   "text": "考古队已经提取九百二十八件套文物，",
   "t0": 363.86,
   "t1": 366.4
  },
  {
   "p": 17,
   "j": 4,
   "text": "一号船的瓷器估计超过十万件。",
   "t0": 366.44,
   "t1": 368.59
  },
  {
   "p": 17,
   "j": 5,
   "text": "一千五百年后的船沉在一千五百米海底，",
   "t0": 368.59,
   "t1": 371.247
  },
  {
   "p": 17,
   "j": 6,
   "text": "两千年前的货埋在王陵里，",
   "t0": 371.247,
   "t1": 373.44
  },
  {
   "p": 17,
   "j": 7,
   "text": "它们像同一条航线留下的两枚时间胶囊。",
   "t0": 373.44,
   "t1": 376.26
  },
  {
   "p": 17,
   "j": 8,
   "text": "深海里，",
   "t0": 376.26,
   "t1": 376.87
  },
  {
   "p": 17,
   "j": 9,
   "text": "会不会还有更早的那一艘？",
   "t0": 376.87,
   "t1": 378.483
  },
  {
   "p": 18,
   "j": 0,
   "text": "二零二五年，",
   "t0": 378.483,
   "t1": 379.22
  },
  {
   "p": 18,
   "j": 1,
   "text": "人民日报报道了一件关键文物，",
   "t0": 379.32,
   "t1": 381.34
  },
  {
   "p": 18,
   "j": 2,
   "text": "浙江宁波出土的战国羽人竞渡纹铜钺。",
   "t0": 381.36,
   "t1": 383.901
  },
  {
   "p": 18,
   "j": 3,
   "text": "它只有手掌大小，",
   "t0": 383.901,
   "t1": 385.04
  },
  {
   "p": 18,
   "j": 4,
   "text": "一面没有纹饰，",
   "t0": 385.04,
   "t1": 385.94
  },
  {
   "p": 18,
   "j": 5,
   "text": "另一面刻着龙纹和四个头戴羽冠、",
   "t0": 385.94,
   "t1": 388.31
  },
  {
   "p": 18,
   "j": 6,
   "text": "并排划船的人。",
   "t0": 388.31,
   "t1": 389.36
  },
  {
   "p": 18,
   "j": 7,
   "text": "四个人身体前倾，",
   "t0": 389.38,
   "t1": 390.66
  },
  {
   "p": 18,
   "j": 8,
   "text": "手臂拉成直线，",
   "t0": 390.66,
   "t1": 391.84
  },
  {
   "p": 18,
   "j": 9,
   "text": "船身是一道弧线。",
   "t0": 391.84,
   "t1": 393.0
  },
  {
   "p": 18,
   "j": 10,
   "text": "它属于两千多年前真实存在的越地器物，",
   "t0": 393.0,
   "t1": 395.77
  },
  {
   "p": 18,
   "j": 11,
   "text": "后来画的《山海经》插图反倒不能替它作证。",
   "t0": 395.77,
   "t1": 398.57
  },
  {
   "p": 18,
   "j": 12,
   "text": "可它偏偏把羽冠和划船刻在了一起，",
   "t0": 398.57,
   "t1": 401.0
  },
  {
   "p": 18,
   "j": 13,
   "text": "这到底是在记录一场比赛，",
   "t0": 401.06,
   "t1": 402.74
  },
  {
   "p": 18,
   "j": 14,
   "text": "还是在记录一种身份？",
   "t0": 402.74,
   "t1": 404.17
  },
  {
   "p": 19,
   "j": 0,
   "text": "越人有崇鸟传统，",
   "t0": 404.17,
   "t1": 405.56
  },
  {
   "p": 19,
   "j": 1,
   "text": "鸟纹、",
   "t0": 405.56,
   "t1": 405.99
  },
  {
   "p": 19,
   "j": 2,
   "text": "鸟篆文、",
   "t0": 405.99,
   "t1": 406.56
  },
  {
   "p": 19,
   "j": 3,
   "text": "羽冠反复出现在器物上。",
   "t0": 406.56,
   "t1": 408.26
  },
  {
   "p": 19,
   "j": 4,
   "text": "所谓羽人，",
   "t0": 408.26,
   "t1": 409.03
  },
  {
   "p": 19,
   "j": 5,
   "text": "很可能是南方水族在祭祀、",
   "t0": 409.03,
   "t1": 410.77
  },
  {
   "p": 19,
   "j": 6,
   "text": "竞渡或远航时的一种形象。",
   "t0": 410.77,
   "t1": 412.6
  },
  {
   "p": 19,
   "j": 7,
   "text": "翅膀也许从来不在身上，",
   "t0": 412.68,
   "t1": 414.22
  },
  {
   "p": 19,
   "j": 8,
   "text": "而在船上。",
   "t0": 414.22,
   "t1": 415.01
  },
  {
   "p": 19,
   "j": 9,
   "text": "若古人戴着羽冠出海，",
   "t0": 415.01,
   "t1": 416.46
  },
  {
   "p": 19,
   "j": 10,
   "text": "远远看见的人会不会真的以为，",
   "t0": 416.54,
   "t1": 418.37
  },
  {
   "p": 19,
   "j": 11,
   "text": "天上的人下到海上来了？",
   "t0": 418.37,
   "t1": 419.81
  },
  {
   "p": 20,
   "j": 0,
   "text": "更巧的是，",
   "t0": 419.81,
   "t1": 420.67
  },
  {
   "p": 20,
   "j": 1,
   "text": "二零二五年《自然·通讯》发表了一项悬棺葬古DNA研究，",
   "t0": 420.67,
   "t1": 425.22
  },
  {
   "p": 20,
   "j": 2,
   "text": "分析中国四个悬棺遗址的十一例古基因组，",
   "t0": 425.24,
   "t1": 428.22
  },
  {
   "p": 20,
   "j": 3,
   "text": "又比较泰国木棺葬遗址和今天华南僰人的全基因组。",
   "t0": 428.22,
   "t1": 431.61
  },
  {
   "p": 20,
   "j": 4,
   "text": "结果显示，",
   "t0": 431.61,
   "t1": 432.33
  },
  {
   "p": 20,
   "j": 5,
   "text": "沿着中国南方和东南亚的悬崖、",
   "t0": 432.33,
   "t1": 434.4
  },
  {
   "p": 20,
   "j": 6,
   "text": "河谷与海岸，",
   "t0": 434.46,
   "t1": 435.45
  },
  {
   "p": 20,
   "j": 7,
   "text": "古代人群之间一直有联系。",
   "t0": 435.45,
   "t1": 437.42
  },
  {
   "p": 20,
   "j": 8,
   "text": "他们和东亚南部沿海的新石器人群关系很深，",
   "t0": 437.48,
   "t1": 440.3
  },
  {
   "p": 20,
   "j": 9,
   "text": "而后者又是侗台语和南岛语人群的重要祖源之一。",
   "t0": 440.4,
   "t1": 443.46999999999997
  },
  {
   "p": 20,
   "j": 10,
   "text": "当航线、",
   "t0": 443.46999999999997,
   "t1": 444.24
  },
  {
   "p": 20,
   "j": 11,
   "text": "羽冠和基因都指向南方海岸，",
   "t0": 444.28,
   "t1": 446.4
  },
  {
   "p": 20,
   "j": 12,
   "text": "羽人的故事会不会是一张被神话包装过的人群迁徙图？",
   "t0": 446.4,
   "t1": 449.98
  },
  {
   "p": 21,
   "j": 0,
   "text": "传说里的丹山，",
   "t0": 449.98,
   "t1": 451.03
  },
  {
   "p": 21,
   "j": 1,
   "text": "没有黑夜，",
   "t0": 451.03,
   "t1": 451.86
  },
  {
   "p": 21,
   "j": 2,
   "text": "永远都是白天。",
   "t0": 451.86,
   "t1": 452.92
  },
  {
   "p": 21,
   "j": 3,
   "text": "极地夏天会出现极昼，",
   "t0": 452.98,
   "t1": 454.53
  },
  {
   "p": 21,
   "j": 4,
   "text": "于是原片把丹山指向南极，",
   "t0": 454.53,
   "t1": 456.36
  },
  {
   "p": 21,
   "j": 5,
   "text": "又拿百越古船去比新西兰毛利人的战船。",
   "t0": 456.36,
   "t1": 458.9
  },
  {
   "p": 21,
   "j": 6,
   "text": "这个联想很猛，",
   "t0": 458.9,
   "t1": 459.86
  },
  {
   "p": 21,
   "j": 7,
   "text": "但考古学找不到远古船队登陆南极的证据，",
   "t0": 459.86,
   "t1": 462.71
  },
  {
   "p": 21,
   "j": 8,
   "text": "也没有发现可信的史前人类城市。",
   "t0": 462.71,
   "t1": 464.72
  },
  {
   "p": 21,
   "j": 9,
   "text": "可如果羽人没有到达南极，",
   "t0": 464.72,
   "t1": 466.38
  },
  {
   "p": 21,
   "j": 10,
   "text": "他们记忆里那个没有黑夜的远方，",
   "t0": 466.44,
   "t1": 468.25
  },
  {
   "p": 21,
   "j": 11,
   "text": "究竟是从哪里来的？",
   "t0": 468.25,
   "t1": 469.90999999999997
  },
  {
   "p": 22,
   "j": 0,
   "text": "二零二三年，",
   "t0": 469.90999999999997,
   "t1": 470.74
  },
  {
   "p": 22,
   "j": 1,
   "text": "《自然·通讯》公布了一项研究。",
   "t0": 470.86,
   "t1": 472.86
  },
  {
   "p": 22,
   "j": 2,
   "text": "科学家用卫星和探冰雷达，",
   "t0": 472.86,
   "t1": 474.75
  },
  {
   "p": 22,
   "j": 3,
   "text": "在东南极冰盖下发现一片宽约三百公里的古代河流地貌。",
   "t0": 474.75,
   "t1": 478.44
  },
  {
   "p": 22,
   "j": 4,
   "text": "它在冰盖形成前被河流刻出来，",
   "t0": 478.44,
   "t1": 480.48
  },
  {
   "p": 22,
   "j": 5,
   "text": "后来封进冰层，",
   "t0": 480.52,
   "t1": 481.58
  },
  {
   "p": 22,
   "j": 6,
   "text": "最久接近三千四百万年。",
   "t0": 481.58,
   "t1": 483.31
  },
  {
   "p": 22,
   "j": 7,
   "text": "二零二五年，",
   "t0": 483.31,
   "t1": 484.02
  },
  {
   "p": 22,
   "j": 8,
   "text": "《自然·地球科学》又扫出东南极边缘大片古河流侵蚀面，",
   "t0": 484.08,
   "t1": 488.18
  },
  {
   "p": 22,
   "j": 9,
   "text": "古河道甚至改变了冰盖流向。",
   "t0": 488.18,
   "t1": 489.90999999999997
  },
  {
   "p": 22,
   "j": 10,
   "text": "二零二六年，",
   "t0": 489.90999999999997,
   "t1": 490.72
  },
  {
   "p": 22,
   "j": 11,
   "text": "《科学》提出，",
   "t0": 490.8,
   "t1": 491.63
  },
  {
   "p": 22,
   "j": 12,
   "text": "大陆裂解后的地幔抬升把甘布尔采夫山脉推高，",
   "t0": 491.63,
   "t1": 494.98
  },
  {
   "p": 22,
   "j": 13,
   "text": "约四千五百万年前达到成冰门槛。",
   "t0": 494.98,
   "t1": 497.40999999999997
  },
  {
   "p": 22,
   "j": 14,
   "text": "南极冰盖，",
   "t0": 497.40999999999997,
   "t1": 498.33
  },
  {
   "p": 22,
   "j": 15,
   "text": "难道从一开始就建在一片远古河流的遗骸上？",
   "t0": 498.33,
   "t1": 501.53
  },
  {
   "p": 23,
   "j": 0,
   "text": "南极冰下没有一座羽人城，",
   "t0": 501.53,
   "t1": 503.4
  },
  {
   "p": 23,
   "j": 1,
   "text": "却埋着一个被冰封了千万年的旧世界。",
   "t0": 503.4,
   "t1": 505.6
  },
  {
   "p": 23,
   "j": 2,
   "text": "河流没了，",
   "t0": 505.76,
   "t1": 506.40999999999997
  },
  {
   "p": 23,
   "j": 3,
   "text": "冰来了，",
   "t0": 506.40999999999997,
   "t1": 507.02
  },
  {
   "p": 23,
   "j": 4,
   "text": "冰盖压了几千万年，",
   "t0": 507.04,
   "t1": 508.46
  },
  {
   "p": 23,
   "j": 5,
   "text": "河道的骨架还留在下面。",
   "t0": 508.54,
   "t1": 510.06
  },
  {
   "p": 23,
   "j": 6,
   "text": "也许丹山是一段被神话压缩过的地球记忆，",
   "t0": 510.18,
   "t1": 512.9300000000001
  },
  {
   "p": 23,
   "j": 7,
   "text": "古人未必到过南极，",
   "t0": 512.9300000000001,
   "t1": 514.14
  },
  {
   "p": 23,
   "j": 8,
   "text": "却可能把一个没有黑夜、",
   "t0": 514.16,
   "t1": 515.7
  },
  {
   "p": 23,
   "j": 9,
   "text": "河流纵横的远方代代传了下来。",
   "t0": 515.72,
   "t1": 517.71
  },
  {
   "p": 23,
   "j": 10,
   "text": "神话说那里永远是白天，",
   "t0": 517.71,
   "t1": 519.56
  },
  {
   "p": 23,
   "j": 11,
   "text": "科学说那里曾经有河。",
   "t0": 519.56,
   "t1": 521.34
  },
  {
   "p": 23,
   "j": 12,
   "text": "一个来自人的想象，",
   "t0": 521.34,
   "t1": 522.54
  },
  {
   "p": 23,
   "j": 13,
   "text": "一个来自地球的档案，",
   "t0": 522.58,
   "t1": 524.04
  },
  {
   "p": 23,
   "j": 14,
   "text": "你说这两者之间，",
   "t0": 524.04,
   "t1": 525.09
  },
  {
   "p": 23,
   "j": 15,
   "text": "真的完全没有关系吗？",
   "t0": 525.09,
   "t1": 526.51
  },
  {
   "p": 24,
   "j": 0,
   "text": "一座找不到主人的王陵，",
   "t0": 526.51,
   "t1": 528.07
  },
  {
   "p": 24,
   "j": 1,
   "text": "一件没有金线的帝王玉衣，",
   "t0": 528.07,
   "t1": 529.88
  },
  {
   "p": 24,
   "j": 2,
   "text": "两公斤五色药石，",
   "t0": 529.88,
   "t1": 531.2230000000001
  },
  {
   "p": 24,
   "j": 3,
   "text": "一个波斯药盒，",
   "t0": 531.2230000000001,
   "t1": 532.1700000000001
  },
  {
   "p": 24,
   "j": 4,
   "text": "近四十枚西亚金花泡，",
   "t0": 532.1700000000001,
   "t1": 534.0500000000001
  },
  {
   "p": 24,
   "j": 5,
   "text": "非洲象牙和红海乳香。",
   "t0": 534.0500000000001,
   "t1": 535.71
  },
  {
   "p": 24,
   "j": 6,
   "text": "它们把广州、",
   "t0": 535.71,
   "t1": 536.66
  },
  {
   "p": 24,
   "j": 7,
   "text": "波斯、",
   "t0": 536.66,
   "t1": 537.18
  },
  {
   "p": 24,
   "j": 8,
   "text": "埃及、",
   "t0": 537.3,
   "t1": 537.84
  },
  {
   "p": 24,
   "j": 9,
   "text": "印度和东南亚串成了一张看不见的网。",
   "t0": 537.9,
   "t1": 540.35
  },
  {
   "p": 24,
   "j": 10,
   "text": "另一边，",
   "t0": 540.35,
   "t1": 540.83
  },
  {
   "p": 24,
   "j": 11,
   "text": "是一把只有手掌大的铜钺，",
   "t0": 540.83,
   "t1": 542.4200000000001
  },
  {
   "p": 24,
   "j": 12,
   "text": "四个戴羽冠的人在一条弧形的船上一起划桨。",
   "t0": 542.4200000000001,
   "t1": 545.56
  },
  {
   "p": 24,
   "j": 13,
   "text": "两千年后，",
   "t0": 545.56,
   "t1": 546.66
  },
  {
   "p": 24,
   "j": 14,
   "text": "古DNA又把中国南方、",
   "t0": 546.72,
   "t1": 548.42
  },
  {
   "p": 24,
   "j": 15,
   "text": "东南亚和太平洋沿岸的人群连在了一起。",
   "t0": 548.44,
   "t1": 550.98
  },
  {
   "p": 24,
   "j": 16,
   "text": "这些看起来毫不相干的物件，",
   "t0": 551.06,
   "t1": 552.96
  },
  {
   "p": 24,
   "j": 17,
   "text": "会不会本来就在讲同一张地图？",
   "t0": 553.0,
   "t1": 554.88
  },
  {
   "p": 25,
   "j": 0,
   "text": "最后是南极冰盖。",
   "t0": 554.9,
   "t1": 556.2
  },
  {
   "p": 25,
   "j": 1,
   "text": "那里没有羽人，",
   "t0": 556.2,
   "t1": 557.1500000000001
  },
  {
   "p": 25,
   "j": 2,
   "text": "却有一条冰封了三千多万年的古代河流。",
   "t0": 557.1500000000001,
   "t1": 559.84
  },
  {
   "p": 25,
   "j": 3,
   "text": "赵佗的墓至今没找到，",
   "t0": 559.86,
   "t1": 561.19
  },
  {
   "p": 25,
   "j": 4,
   "text": "广州的山几乎挖遍，",
   "t0": 561.19,
   "t1": 562.54
  },
  {
   "p": 25,
   "j": 5,
   "text": "只剩越秀山还稳稳压在那里。",
   "t0": 562.54,
   "t1": 564.4300000000001
  },
  {
   "p": 25,
   "j": 6,
   "text": "也许赵佗睡在山下，",
   "t0": 564.4300000000001,
   "t1": 566.2
  },
  {
   "p": 25,
   "j": 7,
   "text": "也许那是一座空墓，",
   "t0": 566.26,
   "t1": 567.44
  },
  {
   "p": 25,
   "j": 8,
   "text": "也许宝藏根本不在棺材里。",
   "t0": 567.44,
   "t1": 569.23
  },
  {
   "p": 25,
   "j": 9,
   "text": "一个国王把货物埋进地下，",
   "t0": 569.23,
   "t1": 570.83
  },
  {
   "p": 25,
   "j": 10,
   "text": "两千年后，",
   "t0": 570.83,
   "t1": 571.71
  },
  {
   "p": 25,
   "j": 11,
   "text": "后人却顺着货物找到了人群、",
   "t0": 571.71,
   "t1": 573.58
  },
  {
   "p": 25,
   "j": 12,
   "text": "技术和地球的另一张脸。",
   "t0": 573.64,
   "t1": 575.32
  },
  {
   "p": 25,
   "j": 13,
   "text": "如果这条海路才是宝藏，",
   "t0": 575.32,
   "t1": 576.97
  },
  {
   "p": 25,
   "j": 14,
   "text": "那赵佗藏起来的究竟是一场葬礼，",
   "t0": 576.97,
   "t1": 579.3100000000001
  },
  {
   "p": 25,
   "j": 15,
   "text": "还是一张通往未来的地图？",
   "t0": 579.3100000000001,
   "t1": 580.9
  },
  {
   "p": 26,
   "j": 0,
   "text": "赵佗没找到长生不老药。",
   "t0": 580.9,
   "t1": 582.56
  },
  {
   "p": 26,
   "j": 1,
   "text": "可他留下的谜，",
   "t0": 582.56,
   "t1": 583.54
  },
  {
   "p": 26,
   "j": 2,
   "text": "让陌生人隔了两千年还在一件件翻他的货物、",
   "t0": 583.54,
   "t1": 586.58
  },
  {
   "p": 26,
   "j": 3,
   "text": "认他的印章、",
   "t0": 586.58,
   "t1": 587.36
  },
  {
   "p": 26,
   "j": 4,
   "text": "追他的航线。",
   "t0": 587.36,
   "t1": 588.24
  },
  {
   "p": 26,
   "j": 5,
   "text": "一个人的身体会烂，",
   "t0": 588.4,
   "t1": 589.64
  },
  {
   "p": 26,
   "j": 6,
   "text": "王宫会被泥土埋住，",
   "t0": 589.66,
   "t1": 591.04
  },
  {
   "p": 26,
   "j": 7,
   "text": "可只要还有人顺着这些线索往前走，",
   "t0": 591.04,
   "t1": 593.52
  },
  {
   "p": 26,
   "j": 8,
   "text": "他就没有真正消失。",
   "t0": 593.66,
   "t1": 594.96
  },
  {
   "p": 27,
   "j": 0,
   "text": "我是艾伦，",
   "t0": 595.02,
   "t1": 595.76
  },
  {
   "p": 27,
   "j": 1,
   "text": "遛狗去了，",
   "t0": 595.76,
   "t1": 596.52
  },
  {
   "p": 27,
   "j": 2,
   "text": "白了个白。",
   "t0": 596.6,
   "t1": 597.34
  }
 ]
}