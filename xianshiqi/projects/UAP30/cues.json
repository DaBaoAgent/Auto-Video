  "captions": [
    {
      "t0": 0.0,
      "t1": 0.86,
      "text": "二零二零年"
    },
    {
      "t0": 0.96,
      "t1": 2.4,
      "text": "美国国防部第一次承认"
    },
    {
      "t0": 2.48,
      "t1": 4.6,
      "text": "三段网传的UFO视频是真的"
    },
    {
      "t0": 4.68,
      "t1": 6.22,
      "text": "可官方给出的答案很别扭"
    },
    {
      "t0": 6.3,
      "t1": 7.0,
      "text": "视频真"
    },
    {
      "t0": 7.1,
      "t1": 8.52,
      "text": "不等于你看见的是飞船"
    },
    {
      "t0": 8.62,
      "t1": 9.28,
      "text": "五年后"
    },
    {
      "t0": 9.38,
      "t1": 10.3,
      "text": "一段新视频又被带进"
    },
    {
      "t0": 10.4,
      "t1": 11.94,
      "text": "美国国会听证会"
    },
    {
      "t0": 12.02,
      "t1": 13.05,
      "text": "画面里一枚导弹"
    },
    {
      "t0": 13.05,
      "t1": 14.34,
      "text": "打中了海上的发光球"
    },
    {
      "t0": 14.42,
      "t1": 15.46,
      "text": "光球没有掉下来"
    },
    {
      "t0": 15.54,
      "t1": 16.34,
      "text": "反而继续飞"
    },
    {
      "t0": 16.44,
      "t1": 17.98,
      "text": "如果这段画面没有被误读"
    },
    {
      "t0": 18.06,
      "t1": 19.08,
      "text": "那么它到底是什么"
    },
    {
      "t0": 19.28,
      "t1": 20.78,
      "text": "故事要从二零零四年"
    },
    {
      "t0": 20.78,
      "t1": 21.82,
      "text": "十一月十四日说起"
    },
    {
      "t0": 21.92,
      "t1": 23.84,
      "text": "美国尼米兹号航母战斗群"
    },
    {
      "t0": 24.0,
      "t1": 25.28,
      "text": "正在加州外海训练"
    },
    {
      "t0": 25.38,
      "t1": 26.53,
      "text": "普林斯顿号的雷达"
    },
    {
      "t0": 26.53,
      "t1": 27.96,
      "text": "突然抓到一群奇怪目标"
    },
    {
      "t0": 28.04,
      "t1": 29.2,
      "text": "它们从一万八千米高空"
    },
    {
      "t0": 29.2,
      "t1": 30.0,
      "text": "急速下坠"
    }
  ],
