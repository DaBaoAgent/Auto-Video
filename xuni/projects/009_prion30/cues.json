    { "t0": 17.44, "t1": 18.76, "text": "刻在基因里的记忆" },
    { "t0": 18.76, "t1": 21.10, "text": "而今天科学家终于在你身上" },
    { "t0": 21.10, "t1": 22.54, "text": "翻出了这份记忆的原件" },
    { "t0": 22.54, "t1": 24.46, "text": "先看一组让所有流行病学家" },
