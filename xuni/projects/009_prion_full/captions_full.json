[
 {
  "text": "你有没有想过一个问题",
  "t0": 0.048,
  "t1": 0.9480000000000001,
  "chunk": 1,
  "p": 1
 },
 {
  "text": "为什么中国的僵尸 欧洲的吸血鬼",
  "t0": 1.04875,
  "t1": 3.3333333333333335,
  "chunk": 1,
  "p": 1
 },
 {
  "text": "阿拉伯的食尸鬼 非洲的活死人",
  "t0": 3.5,
  "t1": 5.585,
  "chunk": 1,
  "p": 1
 },
 {
  "text": "全世界神话里那些吃人的怪物",
  "t0": 5.757692307692308,
  "t1": 7.622307692307693,
  "chunk": 1,
  "p": 1
 },
 {
  "text": "长得都差不多 古人没有互联网 没串过供",
  "t0": 7.775,
  "t1": 10.2625,
  "chunk": 1,
  "p": 1
 },
 {
  "text": "可他们编出来的东西 全是一个路数",
  "t0": 10.617777777777777,
  "t1": 12.453333333333333,
  "chunk": 1,
  "p": 1
 },
 {
  "text": "活着的人吃死人",
  "t0": 12.91,
  "t1": 13.99,
  "chunk": 1,
  "p": 1
 },
 {
  "text": "死了的人爬起来吃活人 这不是巧合",
  "t0": 14.155,
  "t1": 16.372,
  "chunk": 1,
  "p": 1
 },
 {
  "text": "这是我们祖先刻在基因里的记忆",
  "t0": 16.541666666666668,
  "t1": 18.677500000000002,
  "chunk": 1,
  "p": 1
 },
 {
  "text": "而今天 科学家终于在你身上",
  "t0": 18.8575,
  "t1": 21.0025,
  "chunk": 2,
  "p": 1
 },
 {
  "text": "翻出了这份记忆的原件",
  "t0": 21.172,
  "t1": 22.468,
  "chunk": 2,
  "p": 1
 },
 {
  "text": "先看一组让所有流行病学家",
  "t0": 22.84,
  "t1": 24.445555555555558,
  "chunk": 3,
  "p": 2
 },
 {
  "text": "睡不着的数据 上世纪末英国疯牛病",
  "t0": 24.445555555555558,
  "t1": 26.904,
  "chunk": 3,
  "p": 2
 },
 {
  "text": "按当时的传播规模推演",
  "t0": 27.085,
  "t1": 28.615,
  "chunk": 3,
  "p": 2
 },
 {
  "text": "英国本土该有五十万到一百万人 染病死亡",
  "t0": 28.794999999999998,
  "t1": 31.265,
  "chunk": 3,
  "p": 2
 },
 {
  "text": "可几十年过去",
  "t0": 31.448333333333334,
  "t1": 32.348333333333336,
  "chunk": 3,
  "p": 2
 },
 {
  "text": "真正确诊的变异型克雅氏病死亡名单",
  "t0": 32.4975,
  "t1": 34.8225,
  "chunk": 3,
  "p": 2
 },
 {
  "text": "死死钉在一百七十八人",
  "t0": 35.06,
  "t1": 36.34,
  "chunk": 3,
  "p": 2
 },
 {
  "text": "剩下的人怎么没事",
  "t0": 36.5725,
  "t1": 37.5875,
  "chunk": 3,
  "p": 2
 },
 {
  "text": "伦敦大学学院的布兰德尔教授",
  "t0": 38.0,
  "t1": 39.75615384615385,
  "chunk": 4,
  "p": 3
 },
 {
  "text": "把目光对准了一个所有人都",
  "t0": 39.906363636363636,
  "t1": 41.532607655502396,
  "chunk": 4,
  "p": 3
 },
 {
  "text": "觉得没用的东西 阑尾",
  "t0": 41.532607655502396,
  "t1": 42.875,
  "chunk": 4,
  "p": 3
 },
 {
  "text": "他收集了二零零零到二零一二年间",
  "t0": 43.137142857142855,
  "t1": 45.02285714285714,
  "chunk": 5,
  "p": 3
 },
 {
  "text": "全国四十一家医院切下来的",
  "t0": 45.39,
  "t1": 47.089285714285715,
  "chunk": 6,
  "p": 3
 },
 {
  "text": "三万二千四百四十一个阑尾 挨个化验",
  "t0": 47.089285714285715,
  "t1": 49.237500000000004,
  "chunk": 6,
  "p": 3
 },
 {
  "text": "结果是 每两千个英国人里",
  "t0": 49.84,
  "t1": 51.56333333333333,
  "chunk": 7,
  "p": 3
 },
 {
  "text": "就有一个带着这种病毒",
  "t0": 51.75,
  "t1": 53.01,
  "chunk": 7,
  "p": 3
 },
 {
  "text": "可人家活得好好的",
  "t0": 53.15875,
  "t1": 54.261250000000004,
  "chunk": 7,
  "p": 3
 },
 {
  "text": "顺着查下去 他在人类二十号染色体",
  "t0": 54.5,
  "t1": 56.415,
  "chunk": 8,
  "p": 3
 },
 {
  "text": "第一百二十九位",
  "t0": 56.95,
  "t1": 57.778333333333336,
  "chunk": 8,
  "p": 3
 },
 {
  "text": "找到一个关键的氨基酸编码",
  "t0": 57.778333333333336,
  "t1": 59.18833333333333,
  "chunk": 8,
  "p": 3
 },
 {
  "text": "甲硫氨酸和缬氨酸两种 组合成三种人",
  "t0": 59.690000000000005,
  "t1": 62.325,
  "chunk": 9,
  "p": 3
 },
 {
  "text": "快速死的几乎全是双甲硫氨酸型",
  "t0": 62.325,
  "t1": 64.715,
  "chunk": 9,
  "p": 3
 },
 {
  "text": "潜伏几十年才发病的是杂合型",
  "t0": 64.94,
  "t1": 66.83846153846154,
  "chunk": 10,
  "p": 3
 },
 {
  "text": "带着病毒却一辈子没事的",
  "t0": 66.83846153846154,
  "t1": 68.44727272727272,
  "chunk": 10,
  "p": 3
 },
 {
  "text": "全是纯缬氨酸型",
  "t0": 68.61,
  "t1": 69.69,
  "chunk": 10,
  "p": 3
 },
 {
  "text": "科学家把这个位点起",
  "t0": 69.89999999999999,
  "t1": 71.31142857142856,
  "chunk": 11,
  "p": 3
 },
 {
  "text": "名叫朊病毒防御基因 纯抵抗型的人",
  "t0": 71.31142857142856,
  "t1": 74.02,
  "chunk": 11,
  "p": 3
 },
 {
  "text": "全球大约占百分之十三",
  "t0": 74.23818181818181,
  "t1": 75.13818181818182,
  "chunk": 11,
  "p": 3
 },
 {
  "text": "问题来了 这套铠甲",
  "t0": 75.55,
  "t1": 76.45,
  "chunk": 12,
  "p": 3
 },
 {
  "text": "到底是在防什么",
  "t0": 76.71363636363637,
  "t1": 77.61363636363637,
  "chunk": 12,
  "p": 3
 },
 {
  "text": "答案要从一片太平洋小岛讲起",
  "t0": 78.19,
  "t1": 79.81500000000001,
  "chunk": 13,
  "p": 4
 },
 {
  "text": "上世纪五十年代",
  "t0": 80.018,
  "t1": 80.962,
  "chunk": 13,
  "p": 4
 },
 {
  "text": "巴布亚新几内亚的高山里",
  "t0": 81.15545454545455,
  "t1": 82.51363636363637,
  "chunk": 13,
  "p": 4
 },
 {
  "text": "有一支叫弗雷的部落 欧洲医生闯进去",
  "t0": 82.81,
  "t1": 85.17,
  "chunk": 13,
  "p": 4
 },
 {
  "text": "发现一种怪病 病人先是控制不住地笑",
  "t0": 85.17,
  "t1": 87.66799999999999,
  "chunk": 13,
  "p": 4
 },
 {
  "text": "接着全身发抖 走路像踩在棉花上",
  "t0": 87.66799999999999,
  "t1": 90.2475,
  "chunk": 13,
  "p": 4
 },
 {
  "text": "几个月内全瘫 失明",
  "t0": 90.2475,
  "t1": 91.3,
  "chunk": 13,
  "p": 4
 },
 {
  "text": "死去 当地人管这叫库鲁",
  "t0": 92.27250000000001,
  "t1": 93.73625000000001,
  "chunk": 13,
  "p": 4
 },
 {
  "text": "意思是因害怕而颤抖",
  "t0": 94.27333333333334,
  "t1": 95.76666666666667,
  "chunk": 13,
  "p": 4
 },
 {
  "text": "部落里发病的几乎全是妇女和孩子",
  "t0": 95.94166666666666,
  "t1": 98.16222222222221,
  "chunk": 13,
  "p": 4
 },
 {
  "text": "男人很少得",
  "t0": 98.33999999999999,
  "t1": 99.24,
  "chunk": 13,
  "p": 4
 },
 {
  "text": "医生一开始以为是遗传病",
  "t0": 99.32,
  "t1": 100.7290909090909,
  "chunk": 14,
  "p": 4
 },
 {
  "text": "直到他们搞清楚弗雷人的葬礼规矩",
  "t0": 100.86714285714285,
  "t1": 102.94,
  "chunk": 14,
  "p": 4
 },
 {
  "text": "一个族人去世 家里人不埋",
  "t0": 103.1,
  "t1": 104.898,
  "chunk": 14,
  "p": 4
 },
 {
  "text": "而是分着吃掉 男人认领肉",
  "t0": 105.08166666666666,
  "t1": 106.862,
  "chunk": 14,
  "p": 4
 },
 {
  "text": "脑髓这种最金贵的部分 归妇女和孩子",
  "t0": 106.862,
  "t1": 109.45333333333333,
  "chunk": 14,
  "p": 4
 },
 {
  "text": "他们以为这是让亲人的",
  "t0": 109.61315789473684,
  "t1": 110.99930747922437,
  "chunk": 14,
  "p": 4
 },
 {
  "text": "灵魂活在自己身体里 现在你回头看",
  "t0": 110.99930747922437,
  "t1": 113.21833333333333,
  "chunk": 14,
  "p": 4
 },
 {
  "text": "妇女儿童吃脑髓 脑髓里全是病毒",
  "t0": 113.38285714285713,
  "t1": 115.57428571428571,
  "chunk": 14,
  "p": 4
 },
 {
  "text": "发病率最高 严丝合缝",
  "t0": 115.74199999999999,
  "t1": 117.2325,
  "chunk": 14,
  "p": 4
 },
 {
  "text": "一个叫盖达塞克的美国医生",
  "t0": 117.58,
  "t1": 119.10333333333334,
  "chunk": 15,
  "p": 5
 },
 {
  "text": "大胆到把病死弗雷人的脑组织取出来",
  "t0": 119.265,
  "t1": 121.416,
  "chunk": 15,
  "p": 5
 },
 {
  "text": "注射进黑猩猩的脑子里 两年多以后",
  "t0": 121.569,
  "t1": 123.998,
  "chunk": 15,
  "p": 5
 },
 {
  "text": "黑猩猩开始发抖 开始走不了路 开始死",
  "t0": 124.17285714285714,
  "t1": 126.94333333333334,
  "chunk": 15,
  "p": 5
 },
 {
  "text": "一九七六年",
  "t0": 126.94333333333334,
  "t1": 127.84333333333335,
  "chunk": 15,
  "p": 5
 },
 {
  "text": "他拿了诺贝尔奖",
  "t0": 127.99142857142857,
  "t1": 128.89142857142858,
  "chunk": 15,
  "p": 5
 },
 {
  "text": "弗雷人办了几千年的葬礼",
  "t0": 129.0009090909091,
  "t1": 130.6190909090909,
  "chunk": 15,
  "p": 5
 },
 {
  "text": "原来是一场持续了",
  "t0": 130.79,
  "t1": 131.9612918660287,
  "chunk": 15,
  "p": 5
 },
 {
  "text": "几百年的分食死亡通知书",
  "t0": 131.9612918660287,
  "t1": 133.57181818181817,
  "chunk": 15,
  "p": 5
 },
 {
  "text": "可这时候有个问题没人敢接话 这个病",
  "t0": 133.7325,
  "t1": 136.319375,
  "chunk": 15,
  "p": 5
 },
 {
  "text": "在弗雷人中间 到底传了多少代",
  "t0": 136.503125,
  "t1": 138.70812500000002,
  "chunk": 15,
  "p": 5
 },
 {
  "text": "把镜头切回中国 你随便翻一遍正史",
  "t0": 139.08,
  "t1": 140.9625,
  "chunk": 16,
  "p": 6
 },
 {
  "text": "《资治通鉴》也好 《明史》也好",
  "t0": 140.9625,
  "t1": 143.0825,
  "chunk": 16,
  "p": 6
 },
 {
  "text": "会发现一个让人不舒服的词 人相食",
  "t0": 143.0825,
  "t1": 145.32999999999998,
  "chunk": 16,
  "p": 6
 },
 {
  "text": "荒年 战乱 围城 这三个字就冒出来",
  "t0": 145.965,
  "t1": 148.8725,
  "chunk": 16,
  "p": 6
 },
 {
  "text": "唐初有个军阀叫朱粲",
  "t0": 148.8725,
  "t1": 150.30333333333334,
  "chunk": 16,
  "p": 6
 },
 {
  "text": "专门设了一个捣磨寨 把人当军粮",
  "t0": 150.30333333333334,
  "t1": 152.318,
  "chunk": 16,
  "p": 6
 },
 {
  "text": "五胡乱华那几百年 中原史书里甚至有\"",
  "t0": 153.14625,
  "t1": 155.67828571428572,
  "chunk": 16,
  "p": 6
 },
 {
  "text": "两脚羊\"这个专门的叫法",
  "t0": 155.67828571428572,
  "t1": 157.09285714285713,
  "chunk": 16,
  "p": 6
 },
 {
  "text": "把掳来的汉人女子当牲口养 晚上糟蹋 白天宰杀",
  "t0": 157.23083333333332,
  "t1": 160.2975,
  "chunk": 16,
  "p": 6
 },
 {
  "text": "明末崇祯年间 陕西 山西大旱",
  "t0": 160.792,
  "t1": 163.21,
  "chunk": 17,
  "p": 6
 },
 {
  "text": "《明史·五行志》白纸黑字写着",
  "t0": 163.66636363636363,
  "t1": 165.36818181818182,
  "chunk": 17,
  "p": 6
 },
 {
  "text": "老百姓交换着吃自己的孩子",
  "t0": 165.98000000000002,
  "t1": 167.73999999999998,
  "chunk": 17,
  "p": 6
 },
 {
  "text": "你以为这些是野蛮人的专利 错",
  "t0": 168.17000000000002,
  "t1": 169.64583333333334,
  "chunk": 18,
  "p": 7
 },
 {
  "text": "每一个中原王朝崩盘",
  "t0": 170.03222222222223,
  "t1": 171.32333333333332,
  "chunk": 18,
  "p": 7
 },
 {
  "text": "人相食这三个字就会在",
  "t0": 171.69571428571427,
  "t1": 173.25054945054944,
  "chunk": 18,
  "p": 7
 },
 {
  "text": "正史里出现一次又一次 它不是段子",
  "t0": 173.25054945054944,
  "t1": 175.69,
  "chunk": 18,
  "p": 7
 },
 {
  "text": "是写进二十四史的 从生物学的角度看",
  "t0": 175.86375,
  "t1": 178.33874999999998,
  "chunk": 18,
  "p": 7
 },
 {
  "text": "人类吃同类",
  "t0": 178.51399999999998,
  "t1": 179.078,
  "chunk": 18,
  "p": 7
 },
 {
  "text": "从来不只是某一个暴君的癖好",
  "t0": 179.078,
  "t1": 180.97538461538463,
  "chunk": 18,
  "p": 7
 },
 {
  "text": "这是这个物种在极端环境下",
  "t0": 180.97538461538463,
  "t1": 183.14785714285713,
  "chunk": 18,
  "p": 7
 },
 {
  "text": "反复做过的一件事",
  "t0": 183.30928571428572,
  "t1": 184.43928571428572,
  "chunk": 18,
  "p": 7
 },
 {
  "text": "而这件事更早的铁证",
  "t0": 184.5988888888889,
  "t1": 185.54555555555555,
  "chunk": 18,
  "p": 7
 },
 {
  "text": "埋在一万五千年前的英国山洞里",
  "t0": 185.54555555555555,
  "t1": 187.35142857142858,
  "chunk": 18,
  "p": 7
 },
 {
  "text": "英国南部有个切达峡谷",
  "t0": 188.23000000000002,
  "t1": 189.521,
  "chunk": 19,
  "p": 8
 },
 {
  "text": "峡谷里有个高夫洞穴",
  "t0": 189.521,
  "t1": 191.03555555555556,
  "chunk": 19,
  "p": 8
 },
 {
  "text": "一九一零年代开始",
  "t0": 191.03555555555556,
  "t1": 192.1875,
  "chunk": 19,
  "p": 8
 },
 {
  "text": "考古队在里面挖出一大堆人骨 成人的",
  "t0": 192.1875,
  "t1": 195.0675,
  "chunk": 19,
  "p": 8
 },
 {
  "text": "孩子的都有 二零一七年显微镜下一看",
  "t0": 195.2625,
  "t1": 197.95999999999998,
  "chunk": 19,
  "p": 8
 },
 {
  "text": "六百多件标本里",
  "t0": 197.95999999999998,
  "t1": 199.216,
  "chunk": 19,
  "p": 8
 },
 {
  "text": "超过百分之六十五带着刀砍的痕迹 方向 深浅",
  "t0": 199.45888888888888,
  "t1": 202.24461538461537,
  "chunk": 19,
  "p": 8
 },
 {
  "text": "和宰牛宰羊一模一样 骨头被敲开",
  "t0": 202.46307692307693,
  "t1": 205.166,
  "chunk": 19,
  "p": 8
 },
 {
  "text": "里面的骨髓被吸干净",
  "t0": 205.34444444444443,
  "t1": 206.69555555555556,
  "chunk": 19,
  "p": 8
 },
 {
  "text": "更瘆人的是",
  "t0": 206.876,
  "t1": 207.62384615384616,
  "chunk": 20,
  "p": 8
 },
 {
  "text": "好几个颅骨的颅盖被仔细磨过 边缘抛光",
  "t0": 207.62384615384616,
  "t1": 210.5075,
  "chunk": 20,
  "p": 8
 },
 {
  "text": "做成了杯子 一根手臂骨上",
  "t0": 210.708,
  "t1": 212.45333333333332,
  "chunk": 20,
  "p": 8
 },
 {
  "text": "还刻着歪歪扭扭的锯齿纹",
  "t0": 212.61272727272726,
  "t1": 214.06727272727272,
  "chunk": 20,
  "p": 8
 },
 {
  "text": "一万五千年前的人 不是饿疯了",
  "t0": 214.46,
  "t1": 216.362,
  "chunk": 21,
  "p": 9
 },
 {
  "text": "饿疯了不会把颅骨磨成杯子",
  "t0": 216.362,
  "t1": 218.08916666666667,
  "chunk": 21,
  "p": 9
 },
 {
  "text": "不会在骨头上雕花 这是仪式",
  "t0": 218.2325,
  "t1": 219.985,
  "chunk": 21,
  "p": 9
 },
 {
  "text": "和新几内亚弗雷人分食亲人",
  "t0": 220.16333333333336,
  "t1": 221.99666666666667,
  "chunk": 21,
  "p": 9
 },
 {
  "text": "跨着一万五千年 隔着半个地球",
  "t0": 222.28,
  "t1": 224.1769230769231,
  "chunk": 21,
  "p": 9
 },
 {
  "text": "做的是同一件事",
  "t0": 224.34,
  "t1": 225.31846153846155,
  "chunk": 21,
  "p": 9
 },
 {
  "text": "从英国山洞到太平洋小岛",
  "t0": 225.48454545454547,
  "t1": 227.17545454545453,
  "chunk": 21,
  "p": 9
 },
 {
  "text": "再到中国史书",
  "t0": 227.35999999999999,
  "t1": 228.36,
  "chunk": 21,
  "p": 9
 },
 {
  "text": "人类像被一只看不见的手捏着",
  "t0": 228.53923076923078,
  "t1": 230.44076923076923,
  "chunk": 21,
  "p": 9
 },
 {
  "text": "在同一条河里反复走",
  "t0": 230.60222222222222,
  "t1": 231.9177777777778,
  "chunk": 21,
  "p": 9
 },
 {
  "text": "可这件事真正的代价",
  "t0": 232.07777777777778,
  "t1": 233.32222222222222,
  "chunk": 21,
  "p": 9
 },
 {
  "text": "要等到二十世纪才被人看见",
  "t0": 233.514,
  "t1": 235.368,
  "chunk": 21,
  "p": 9
 },
 {
  "text": "上世纪七十年代末",
  "t0": 235.67000000000002,
  "t1": 236.67000000000002,
  "chunk": 22,
  "p": 10
 },
 {
  "text": "加州大学有个叫普鲁西纳的助理教授 破产了",
  "t0": 236.85125,
  "t1": 239.76,
  "chunk": 22,
  "p": 10
 },
 {
  "text": "他抛出一个说法 库鲁病 疯牛病 羊瘙痒症",
  "t0": 239.9742857142857,
  "t1": 242.27,
  "chunk": 22,
  "p": 10
 },
 {
  "text": "克雅氏病 根本不是病毒 不是细菌",
  "t0": 242.27,
  "t1": 245.36823529411765,
  "chunk": 22,
  "p": 10
 },
 {
  "text": "而是一种蛋白质在传染",
  "t0": 245.53400000000002,
  "t1": 246.86599999999999,
  "chunk": 22,
  "p": 10
 },
 {
  "text": "没有脱氧核糖核酸 没有核糖核酸",
  "t0": 247.0257142857143,
  "t1": 249.25428571428571,
  "chunk": 22,
  "p": 10
 },
 {
  "text": "一个蛋白质 像活物一样复制",
  "t0": 249.4225,
  "t1": 251.23749999999998,
  "chunk": 22,
  "p": 10
 },
 {
  "text": "整个学术界都觉得他疯了",
  "t0": 251.39545454545453,
  "t1": 252.90454545454546,
  "chunk": 22,
  "p": 10
 },
 {
  "text": "蛋白质没有遗传物质 凭什么传染",
  "t0": 253.06428571428572,
  "t1": 255.25571428571428,
  "chunk": 22,
  "p": 10
 },
 {
  "text": "他被解了雇 研究经费被砍 后来自嘲说",
  "t0": 255.524,
  "t1": 258.09,
  "chunk": 23,
  "p": 10
 },
 {
  "text": "大不了去卖房子 可他描述的机制 准得可怕",
  "t0": 258.25666666666666,
  "t1": 261.1345454545455,
  "chunk": 23,
  "p": 10
 },
 {
  "text": "他说这东西就像过冷水",
  "t0": 261.1345454545455,
  "t1": 262.721,
  "chunk": 23,
  "p": 10
 },
 {
  "text": "水已经零下却还没结冰 只要碰一下",
  "t0": 262.8863636363636,
  "t1": 265.462,
  "chunk": 23,
  "p": 10
 },
 {
  "text": "一个分子改变晶体结构 瞬间连锁反应",
  "t0": 265.6313333333333,
  "t1": 268.2941666666667,
  "chunk": 23,
  "p": 10
 },
 {
  "text": "整杯水变成冰",
  "t0": 268.48583333333335,
  "t1": 269.44416666666666,
  "chunk": 23,
  "p": 10
 },
 {
  "text": "错误折叠的蛋白进了大脑",
  "t0": 269.61545454545455,
  "t1": 271.12454545454545,
  "chunk": 23,
  "p": 10
 },
 {
  "text": "就是这么把所有正",
  "t0": 271.2811764705882,
  "t1": 272.5035986159169,
  "chunk": 23,
  "p": 10
 },
 {
  "text": "常蛋白一个个带歪的 一九九七年",
  "t0": 272.5035986159169,
  "t1": 274.08,
  "chunk": 23,
  "p": 10
 },
 {
  "text": "诺贝尔奖颁给了他",
  "t0": 274.32,
  "t1": 276.0,
  "chunk": 23,
  "p": 10
 },
 {
  "text": "而他这套理论真正解释的那场灾难",
  "t0": 276.264,
  "t1": 278.51733333333334,
  "chunk": 24,
  "p": 10
 },
 {
  "text": "是人类自己喂出来的",
  "t0": 278.51733333333334,
  "t1": 279.9222222222222,
  "chunk": 24,
  "p": 10
 },
 {
  "text": "一九八四年 英国一个乡村兽医解剖了",
  "t0": 280.19,
  "t1": 282.23055555555555,
  "chunk": 25,
  "p": 11
 },
 {
  "text": "一头一百三十三号母牛",
  "t0": 282.23055555555555,
  "t1": 283.925,
  "chunk": 25,
  "p": 11
 },
 {
  "text": "温顺的牛突然撞人 瘫软 抽搐",
  "t0": 284.135,
  "t1": 286.1890909090909,
  "chunk": 25,
  "p": 11
 },
 {
  "text": "打开脑子全是洞",
  "t0": 286.47636363636366,
  "t1": 287.37636363636364,
  "chunk": 25,
  "p": 11
 },
 {
  "text": "这就是疯牛病的起点",
  "t0": 287.87222222222226,
  "t1": 289.0277777777778,
  "chunk": 25,
  "p": 11
 },
 {
  "text": "流行病学家约翰翻遍饲料清单",
  "t0": 289.1871428571429,
  "t1": 291.43833333333333,
  "chunk": 25,
  "p": 11
 },
 {
  "text": "揪出一句农场行话 客厅里的蛋糕",
  "t0": 291.43833333333333,
  "t1": 293.9225,
  "chunk": 25,
  "p": 11
 },
 {
  "text": "客厅是挤奶厅 蛋糕是压缩蛋白饲料砖",
  "t0": 294.09749999999997,
  "t1": 296.386,
  "chunk": 25,
  "p": 11
 },
 {
  "text": "这砖是什么做的 肉骨粉",
  "t0": 296.386,
  "t1": 298.24333333333334,
  "chunk": 25,
  "p": 11
 },
 {
  "text": "把昨天死掉的牛羊骨头和肉磨碎晒干",
  "t0": 298.41999999999996,
  "t1": 300.5,
  "chunk": 25,
  "p": 11
 },
 {
  "text": "再喂给今天活着的牛",
  "t0": 300.97444444444443,
  "t1": 302.16555555555556,
  "chunk": 25,
  "p": 11
 },
 {
  "text": "说白了 这就是让牛自己吃自己",
  "t0": 302.4,
  "t1": 304.286,
  "chunk": 26,
  "p": 11
 },
 {
  "text": "病牛磨成粉 粉喂给健康牛 牛病得更快",
  "t0": 304.286,
  "t1": 307.236,
  "chunk": 26,
  "p": 11
 },
 {
  "text": "而牛身上人吃的肉和脂肪",
  "t0": 307.41909090909087,
  "t1": 309.0009090909091,
  "chunk": 26,
  "p": 11
 },
 {
  "text": "被做成一磅半的汉堡",
  "t0": 309.15666666666664,
  "t1": 310.3833333333333,
  "chunk": 26,
  "p": 11
 },
 {
  "text": "送进了英国的学校食堂",
  "t0": 310.53999999999996,
  "t1": 311.98,
  "chunk": 26,
  "p": 11
 },
 {
  "text": "一九九五年",
  "t0": 312.56,
  "t1": 313.14363636363635,
  "chunk": 27,
  "p": 12
 },
 {
  "text": "一个十九岁的英国男孩斯蒂芬",
  "t0": 313.14363636363635,
  "t1": 314.81636363636363,
  "chunk": 27,
  "p": 12
 },
 {
  "text": "从一场怪病开始",
  "t0": 314.81636363636363,
  "t1": 316.0514285714286,
  "chunk": 27,
  "p": 12
 },
 {
  "text": "几个月内先后失去走路 吃饭 说话",
  "t0": 316.0514285714286,
  "t1": 318.3855555555556,
  "chunk": 27,
  "p": 12
 },
 {
  "text": "认字的能力 死去",
  "t0": 318.3855555555556,
  "t1": 320.54,
  "chunk": 27,
  "p": 12
 },
 {
  "text": "尸检医生看见他大脑里的",
  "t0": 320.54,
  "t1": 322.1881717451524,
  "chunk": 27,
  "p": 12
 },
 {
  "text": "异常蛋白围着空洞 像一朵朵向日葵",
  "t0": 322.1881717451524,
  "t1": 324.5185714285715,
  "chunk": 27,
  "p": 12
 },
 {
  "text": "和疯牛病牛脑子里的一模一样",
  "t0": 324.67384615384617,
  "t1": 325.8553846153846,
  "chunk": 27,
  "p": 12
 },
 {
  "text": "到这一步 英国政府才承认",
  "t0": 326.60249999999996,
  "t1": 328.12285714285713,
  "chunk": 27,
  "p": 12
 },
 {
  "text": "扑杀了四百四十万头牛",
  "t0": 328.12285714285713,
  "t1": 329.7733333333333,
  "chunk": 27,
  "p": 12
 },
 {
  "text": "可这些牛怎么烧",
  "t0": 329.9742857142857,
  "t1": 330.8742857142857,
  "chunk": 27,
  "p": 12
 },
 {
  "text": "病毒细菌怕高温怕强碱",
  "t0": 331.214,
  "t1": 332.395,
  "chunk": 28,
  "p": 12
 },
 {
  "text": "朊病毒没有基因链",
  "t0": 332.395,
  "t1": 333.92,
  "chunk": 28,
  "p": 12
 },
 {
  "text": "你怎么杀死一个本来就不算活的东西",
  "t0": 334.22375,
  "t1": 336.13625,
  "chunk": 28,
  "p": 12
 },
 {
  "text": "最后骨粉堆进十三个废弃空军基地",
  "t0": 336.29846153846154,
  "t1": 338.66153846153844,
  "chunk": 28,
  "p": 12
 },
 {
  "text": "《太阳报》记者卧底拍回画面",
  "t0": 338.8372727272727,
  "t1": 340.38272727272727,
  "chunk": 28,
  "p": 12
 },
 {
  "text": "三十米高的骨粉堆成黑色沙丘",
  "t0": 340.38272727272727,
  "t1": 342.5981818181818,
  "chunk": 28,
  "p": 12
 },
 {
  "text": "露着没磨干净的牙",
  "t0": 342.5981818181818,
  "t1": 343.90000000000003,
  "chunk": 28,
  "p": 12
 },
 {
  "text": "这批东西后来进水泥窑",
  "t0": 343.90000000000003,
  "t1": 345.442,
  "chunk": 28,
  "p": 12
 },
 {
  "text": "一千四百度烧到二零零八年才清完",
  "t0": 345.442,
  "t1": 348.17,
  "chunk": 28,
  "p": 12
 },
 {
  "text": "人终于把牛逼成了同类相食 然后发现",
  "t0": 348.44,
  "t1": 350.88666666666666,
  "chunk": 28,
  "p": 12
 },
 {
  "text": "自己身上那套机制也没关",
  "t0": 351.06,
  "t1": 352.79333333333335,
  "chunk": 28,
  "p": 12
 },
 {
  "text": "二零一零年 法国国家农业研究院",
  "t0": 353.2,
  "t1": 355.236,
  "chunk": 29,
  "p": 13
 },
 {
  "text": "一个二十四岁的女研究员埃米莉",
  "t0": 355.4472727272727,
  "t1": 357.0181818181818,
  "chunk": 29,
  "p": 13
 },
 {
  "text": "戴两层手套夹样本 镊子一滑 穿透手套",
  "t0": 357.0181818181818,
  "t1": 360.15875,
  "chunk": 29,
  "p": 13
 },
 {
  "text": "在拇指上轻轻扎了一下 几乎没出血",
  "t0": 360.337,
  "t1": 362.664,
  "chunk": 29,
  "p": 13
 },
 {
  "text": "伤口自己长好了 她消了毒 签了字",
  "t0": 362.84,
  "t1": 365.24666666666667,
  "chunk": 29,
  "p": 13
 },
 {
  "text": "转身忘了这件事 七年半后",
  "t0": 365.525,
  "t1": 367.605,
  "chunk": 29,
  "p": 13
 },
 {
  "text": "她左侧身体开始麻木 失控",
  "t0": 367.78555555555556,
  "t1": 369.645,
  "chunk": 29,
  "p": 13
 },
 {
  "text": "走路说话的能力一点点消失",
  "t0": 369.8566666666666,
  "t1": 371.54333333333335,
  "chunk": 29,
  "p": 13
 },
 {
  "text": "三十三岁那年死去",
  "t0": 371.54333333333335,
  "t1": 372.93399999999997,
  "chunk": 29,
  "p": 13
 },
 {
  "text": "翻回当年的事故报告 才对上那一下",
  "t0": 372.93399999999997,
  "t1": 375.2766666666667,
  "chunk": 29,
  "p": 13
 },
 {
  "text": "几十个病毒进血 就是百分之百的死亡",
  "t0": 375.65999999999997,
  "t1": 378.02333333333337,
  "chunk": 30,
  "p": 13
 },
 {
  "text": "把这个案子和开头那个五十二",
  "t0": 378.38,
  "t1": 380.1166304347826,
  "chunk": 31,
  "p": 14
 },
 {
  "text": "年前打了一针生长激素",
  "t0": 380.1166304347826,
  "t1": 381.45250000000004,
  "chunk": 31,
  "p": 14
 },
 {
  "text": "五十二年后才死的妇女放在一起看",
  "t0": 381.45250000000004,
  "t1": 383.7058333333333,
  "chunk": 31,
  "p": 14
 },
 {
  "text": "同样的病毒 为什么有人潜伏五十二年",
  "t0": 383.882,
  "t1": 386.17625,
  "chunk": 31,
  "p": 14
 },
 {
  "text": "有人一个月就暴毙",
  "t0": 386.35249999999996,
  "t1": 387.25249999999994,
  "chunk": 31,
  "p": 14
 },
 {
  "text": "回到二十号染色体那三个基因型",
  "t0": 387.525,
  "t1": 389.225,
  "chunk": 31,
  "p": 14
 },
 {
  "text": "保护你的基因不同 结局就不同",
  "t0": 389.55125000000004,
  "t1": 391.484,
  "chunk": 31,
  "p": 14
 },
 {
  "text": "可这还不是最细思极恐的",
  "t0": 391.6563636363636,
  "t1": 393.18363636363637,
  "chunk": 31,
  "p": 14
 },
 {
  "text": "科学家顺着分子钟一倒推",
  "t0": 393.34,
  "t1": 394.94,
  "chunk": 31,
  "p": 14
 },
 {
  "text": "这套基因的选择压力 不是几百年",
  "t0": 394.94,
  "t1": 397.212,
  "chunk": 31,
  "p": 14
 },
 {
  "text": "不是几千年 是五十万年",
  "t0": 397.38800000000003,
  "t1": 398.99666666666667,
  "chunk": 31,
  "p": 14
 },
 {
  "text": "五十万年前",
  "t0": 399.38,
  "t1": 400.14666666666665,
  "chunk": 32,
  "p": 15
 },
 {
  "text": "智人的祖先还在非洲草原上 没有农业 没有冰箱",
  "t0": 400.14666666666665,
  "t1": 403.53,
  "chunk": 32,
  "p": 15
 },
 {
  "text": "饥荒一来 能吃的东西不多",
  "t0": 403.53,
  "t1": 405.4942857142857,
  "chunk": 32,
  "p": 15
 },
 {
  "text": "考古告诉我们 那个时代的人骨上",
  "t0": 405.66999999999996,
  "t1": 407.785,
  "chunk": 32,
  "p": 15
 },
 {
  "text": "留着和猎物骨头上一样的砍痕 同类相食",
  "t0": 407.9315384615385,
  "t1": 410.245,
  "chunk": 32,
  "p": 15
 },
 {
  "text": "在那个年代不是传说",
  "t0": 410.64444444444445,
  "t1": 411.65777777777777,
  "chunk": 32,
  "p": 15
 },
 {
  "text": "是生存策略 错误折叠的蛋白",
  "t0": 412.182,
  "t1": 414.36285714285714,
  "chunk": 32,
  "p": 15
 },
 {
  "text": "顺着人肉进了人体",
  "t0": 414.36285714285714,
  "t1": 415.61375,
  "chunk": 32,
  "p": 15
 },
 {
  "text": "双甲硫氨酸型的人一批批倒下",
  "t0": 415.61375,
  "t1": 417.9175,
  "chunk": 32,
  "p": 15
 },
 {
  "text": "纯缬氨酸型的活下来 生孩子",
  "t0": 417.9175,
  "t1": 420.03999999999996,
  "chunk": 32,
  "p": 15
 },
 {
  "text": "一代一代 一千年一千年",
  "t0": 420.50399999999996,
  "t1": 422.10166666666663,
  "chunk": 33,
  "p": 15
 },
 {
  "text": "铠甲被刻进大多数人的基因组",
  "t0": 422.10166666666663,
  "t1": 423.88076923076926,
  "chunk": 33,
  "p": 15
 },
 {
  "text": "你今天能好好刷到这条视频 说穿了",
  "t0": 424.40999999999997,
  "t1": 426.6766666666667,
  "chunk": 34,
  "p": 16
 },
 {
  "text": "不是运气好 是你的祖先在那场吃与被",
  "t0": 426.87600000000003,
  "t1": 429.10959150326795,
  "chunk": 34,
  "p": 16
 },
 {
  "text": "吃的淘汰赛里 赢了",
  "t0": 429.10959150326795,
  "t1": 430.5585714285714,
  "chunk": 34,
  "p": 16
 },
 {
  "text": "全世界神话里那些吃人的僵尸 吸血鬼 活死人",
  "t0": 430.7442857142857,
  "t1": 434.08714285714285,
  "chunk": 34,
  "p": 16
 },
 {
  "text": "不是古人想象力太丰富",
  "t0": 434.25,
  "t1": 435.51,
  "chunk": 34,
  "p": 16
 },
 {
  "text": "那是一场瘟疫刻在部落记忆里的剪影",
  "t0": 435.6573333333333,
  "t1": 437.82266666666663,
  "chunk": 34,
  "p": 16
 },
 {
  "text": "一代一代口耳相传",
  "t0": 437.9770588235294,
  "t1": 439.0558823529412,
  "chunk": 34,
  "p": 16
 },
 {
  "text": "最后变成了怪物故事",
  "t0": 439.21,
  "t1": 440.4429411764706,
  "chunk": 34,
  "p": 16
 },
 {
  "text": "我们不是没有同类相食过",
  "t0": 440.5981818181818,
  "t1": 442.1618181818182,
  "chunk": 34,
  "p": 16
 },
 {
  "text": "我们是活下来的那一批",
  "t0": 442.31100000000004,
  "t1": 443.589,
  "chunk": 34,
  "p": 16
 },
 {
  "text": "故事到这还没完 二零二四年",
  "t0": 443.95,
  "t1": 445.1788888888889,
  "chunk": 35,
  "p": 17
 },
 {
  "text": "医学界炸了一颗雷",
  "t0": 445.4166666666667,
  "t1": 447.0811111111111,
  "chunk": 35,
  "p": 17
 },
 {
  "text": "五个几十年前注射过",
  "t0": 447.0811111111111,
  "t1": 448.63311111111113,
  "chunk": 35,
  "p": 17
 },
 {
  "text": "尸体提取生长激素的病人",
  "t0": 448.63311111111113,
  "t1": 450.53000000000003,
  "chunk": 35,
  "p": 17
 },
 {
  "text": "陆续查出早老性痴呆",
  "t0": 450.6977777777778,
  "t1": 451.9422222222222,
  "chunk": 35,
  "p": 17
 },
 {
  "text": "科学家在他们脑子里",
  "t0": 452.1011111111111,
  "t1": 453.3988888888889,
  "chunk": 35,
  "p": 17
 },
 {
  "text": "找到了β淀粉样蛋白斑块 这种斑块",
  "t0": 453.55583333333334,
  "t1": 456.03499999999997,
  "chunk": 35,
  "p": 17
 },
 {
  "text": "过去一直被当成阿尔茨海默",
  "t0": 456.03499999999997,
  "t1": 458.0105555555555,
  "chunk": 35,
  "p": 17
 },
 {
  "text": "病自发产生的 现在第一次被证明",
  "t0": 458.0105555555555,
  "t1": 460.2425,
  "chunk": 35,
  "p": 17
 },
 {
  "text": "它能像朊病毒一样 人传人",
  "t0": 460.3975,
  "t1": 461.4475,
  "chunk": 35,
  "p": 17
 },
 {
  "text": "同一年 另一组科学家把阿尔茨海默",
  "t0": 462.282,
  "t1": 464.2488,
  "chunk": 36,
  "p": 17
 },
 {
  "text": "病人脑子里的 tau 蛋白",
  "t0": 464.2488,
  "t1": 465.90500000000003,
  "chunk": 36,
  "p": 17
 },
 {
  "text": "注射进猕猴的内嗅皮层 十八个月后",
  "t0": 466.055,
  "t1": 467.78000000000003,
  "chunk": 36,
  "p": 17
 },
 {
  "text": "这种错误折叠蛋白",
  "t0": 467.78000000000003,
  "t1": 469.58,
  "chunk": 36,
  "p": 17
 },
 {
  "text": "从内嗅皮层一路扩散到海马",
  "t0": 469.58,
  "t1": 471.36,
  "chunk": 36,
  "p": 17
 },
 {
  "text": "和人类病程一模一样",
  "t0": 471.68,
  "t1": 472.8,
  "chunk": 36,
  "p": 17
 },
 {
  "text": "换句话说 朊病毒这种机制 根本不是牛 不是鹿",
  "t0": 473.34,
  "t1": 476.605,
  "chunk": 37,
  "p": 18
 },
 {
  "text": "不是弗雷人专属",
  "t0": 476.775,
  "t1": 477.67499999999995,
  "chunk": 37,
  "p": 18
 },
 {
  "text": "你身边如果有患阿尔茨海默病的长辈",
  "t0": 477.94875,
  "t1": 479.73625,
  "chunk": 37,
  "p": 18
 },
 {
  "text": "他们脑子里缠成一团的  tau 蛋白",
  "t0": 480.15153846153845,
  "t1": 481.86846153846153,
  "chunk": 37,
  "p": 18
 },
 {
  "text": "和疯牛病牛脑子里那种折叠错误",
  "t0": 482.0285714285714,
  "t1": 483.8,
  "chunk": 37,
  "p": 18
 },
 {
  "text": "本质上是同一类东西",
  "t0": 484.4822222222222,
  "t1": 485.4777777777778,
  "chunk": 37,
  "p": 18
 },
 {
  "text": "你的大脑每天都在",
  "t0": 485.6158823529412,
  "t1": 486.7585813148789,
  "chunk": 37,
  "p": 18
 },
 {
  "text": "产生错误折叠的蛋白",
  "t0": 486.7585813148789,
  "t1": 488.04411764705884,
  "chunk": 37,
  "p": 18
 },
 {
  "text": "你的细胞每天都在清理",
  "t0": 488.203,
  "t1": 489.697,
  "chunk": 37,
  "p": 18
 },
 {
  "text": "五十万年前那场仗 没打完",
  "t0": 489.87833333333333,
  "t1": 491.56,
  "chunk": 38,
  "p": 18
 },
 {
  "text": "只是从大草原",
  "t0": 491.7611764705882,
  "t1": 492.6611764705882,
  "chunk": 38,
  "p": 18
 },
 {
  "text": "搬进了你三磅重的脑壳里",
  "t0": 492.7352941176471,
  "t1": 493.87176470588236,
  "chunk": 38,
  "p": 18
 },
 {
  "text": "你染色体上那两个缬氨酸",
  "t0": 494.5081818181818,
  "t1": 495.8718181818182,
  "chunk": 38,
  "p": 18
 },
 {
  "text": "就像身体预装了五十万年的杀毒软件",
  "t0": 496.025,
  "t1": 498.235,
  "chunk": 38,
  "p": 18
 },
 {
  "text": "平时看不见 新的折叠蛋白一冒头",
  "t0": 498.418,
  "t1": 500.41666666666663,
  "chunk": 38,
  "p": 18
 },
 {
  "text": "它先挡一道",
  "t0": 500.41666666666663,
  "t1": 501.36,
  "chunk": 38,
  "p": 18
 },
 {
  "text": "下次体检",
  "t0": 501.69,
  "t1": 502.46375,
  "chunk": 39,
  "p": 19
 },
 {
  "text": "大夫说你阑尾没事 别嫌它是个废物",
  "t0": 502.46375,
  "t1": 504.8342857142857,
  "chunk": 39,
  "p": 19
 },
 {
  "text": "它可能替你存着一份五十万年前的 体检报告",
  "t0": 504.8342857142857,
  "t1": 507.6376470588236,
  "chunk": 39,
  "p": 19
 },
 {
  "text": "世界各国到今天还规定",
  "t0": 507.79100000000005,
  "t1": 509.06899999999996,
  "chunk": 39,
  "p": 19
 },
 {
  "text": "一九八零到一九九六年间在",
  "t0": 509.06899999999996,
  "t1": 510.63704395604395,
  "chunk": 39,
  "p": 19
 },
 {
  "text": "英国待过三个月的人 永久不能献血",
  "t0": 510.63704395604395,
  "t1": 512.5266666666666,
  "chunk": 39,
  "p": 19
 },
 {
  "text": "连检测都没法做",
  "t0": 513.0400000000001,
  "t1": 514.0,
  "chunk": 39,
  "p": 19
 },
 {
  "text": "因为这东西没有基因链",
  "t0": 514.1510000000001,
  "t1": 515.429,
  "chunk": 39,
  "p": 19
 },
 {
  "text": "常规试剂查不出来",
  "t0": 515.5875,
  "t1": 516.8125,
  "chunk": 39,
  "p": 19
 },
 {
  "text": "你身体里那条五十年前留下的防线",
  "t0": 516.9884615384615,
  "t1": 519.1115384615385,
  "chunk": 39,
  "p": 19
 },
 {
  "text": "到底顶不顶得住下一种新的折叠蛋白",
  "t0": 519.2775,
  "t1": 521.6025,
  "chunk": 39,
  "p": 19
 },
 {
  "text": "没人敢打包票",
  "t0": 521.765,
  "t1": 522.665,
  "chunk": 39,
  "p": 19
 },
 {
  "text": "你脑子里那场战争 今天还在打 而你",
  "t0": 522.97,
  "t1": 525.5,
  "chunk": 40,
  "p": 20
 },
 {
  "text": "是五十万年来无数次冲锋之后",
  "t0": 525.5,
  "t1": 527.6716666666666,
  "chunk": 40,
  "p": 20
 },
 {
  "text": "唯一还站着的那一个",
  "t0": 527.8311111111111,
  "t1": 528.9688888888888,
  "chunk": 40,
  "p": 20
 },
 {
  "text": "我是艾伦 遛狗去了 白了个白",
  "t0": 529.41,
  "t1": 531.27,
  "chunk": 41,
  "p": 21
 }
]