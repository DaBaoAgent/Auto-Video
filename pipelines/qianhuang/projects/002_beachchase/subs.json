[
  {"t0": 0.14, "t1": 1.55, "text": "你看过《十三号星期五》吗"},
  {"t0": 1.59, "t1": 2.21, "text": "湖边营地"},
  {"t0": 2.25, "t1": 3.19, "text": "戴面具的杰森"},
  {"t0": 3.23, "t1": 5.00, "text": "一个接一个倒下的年轻人"},
  {"t0": 5.04, "t1": 6.31, "text": "多少人童年的阴影"},
  {"t0": 6.35, "t1": 7.67, "text": "但你不知道的是"},
  {"t0": 7.71, "t1": 9.02, "text": "这部片子是抄的"},
  {"t0": 9.06, "t1": 10.01, "text": "它抄的那部原版"},
  {"t0": 10.05, "t1": 11.29, "text": "是一部一九七一年的"},
  {"t0": 11.33, "t1": 11.99, "text": "意大利老片"},
  {"t0": 12.03, "t1": 12.56, "text": "《血之海滩》"},
  {"t0": 12.60, "t1": 14.16, "text": "铅黄名导马里奥·巴瓦"},
  {"t0": 14.20, "t1": 14.69, "text": "的名作"},
  {"t0": 14.73, "t1": 15.89, "text": "我为了做这一期"},
  {"t0": 15.93, "t1": 17.27, "text": "把这部老片翻出来"},
  {"t0": 17.31, "t1": 18.30, "text": "又盘了好几遍"},
  {"t0": 18.34, "t1": 19.12, "text": "越盘越觉得"},
  {"t0": 19.16, "t1": 20.11, "text": "后来的恐怖片"},
  {"t0": 20.15, "t1": 21.42, "text": "全都欠它一句谢谢"}
]
