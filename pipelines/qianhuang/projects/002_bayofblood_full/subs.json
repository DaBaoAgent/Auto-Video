[
 {
  "t0": 0.14,
  "t1": 1.55,
  "text": "你看过《十三号星期五》吗"
 },
 {
  "t0": 1.59,
  "t1": 2.21,
  "text": "湖边营地"
 },
 {
  "t0": 2.25,
  "t1": 3.19,
  "text": "戴面具的杰森"
 },
 {
  "t0": 3.23,
  "t1": 5.0,
  "text": "一个接一个倒下的年轻人"
 },
 {
  "t0": 5.04,
  "t1": 6.31,
  "text": "多少人童年的阴影"
 },
 {
  "t0": 6.35,
  "t1": 7.67,
  "text": "但你不知道的是"
 },
 {
  "t0": 7.71,
  "t1": 9.02,
  "text": "这部片子是抄的"
 },
 {
  "t0": 9.06,
  "t1": 10.01,
  "text": "它抄的那部原版"
 },
 {
  "t0": 10.05,
  "t1": 11.29,
  "text": "是一部一九七一年的"
 },
 {
  "t0": 11.33,
  "t1": 11.99,
  "text": "意大利老片"
 },
 {
  "t0": 12.03,
  "t1": 12.56,
  "text": "《血之海滩》"
 },
 {
  "t0": 12.6,
  "t1": 14.16,
  "text": "铅黄名导马里奥·巴瓦"
 },
 {
  "t0": 14.2,
  "t1": 14.69,
  "text": "的名作"
 },
 {
  "t0": 14.73,
  "t1": 15.89,
  "text": "我为了做这一期"
 },
 {
  "t0": 15.93,
  "t1": 17.27,
  "text": "把这部老片翻出来"
 },
 {
  "t0": 17.31,
  "t1": 18.3,
  "text": "又盘了好几遍"
 },
 {
  "t0": 18.34,
  "t1": 19.12,
  "text": "越盘越觉得"
 },
 {
  "t0": 19.16,
  "t1": 20.11,
  "text": "后来的恐怖片"
 },
 {
  "t0": 20.15,
  "t1": 21.42,
  "text": "全都欠它一句谢谢"
 },
 {
  "t0": 21.48,
  "t1": 22.59,
  "text": "先交代一下背景"
 },
 {
  "t0": 22.63,
  "t1": 24.06,
  "text": "铅黄这名字听着玄乎"
 },
 {
  "t0": 24.1,
  "t1": 26.63,
  "text": "说白了就是意大利本土的悬疑凶杀片"
 },
 {
  "t0": 26.67,
  "t1": 28.73,
  "text": "戴黑手套的凶手漂亮的受害者"
 },
 {
  "t0": 28.77,
  "t1": 30.04,
  "text": "色调一个比一个艳"
 },
 {
  "t0": 30.08,
  "t1": 30.87,
  "text": "为啥叫铅黄"
 },
 {
  "t0": 30.91,
  "t1": 33.92,
  "text": "因为当年这类侦探小说的封面统一是黄色的"
 },
 {
  "t0": 33.96,
  "t1": 36.81,
  "text": "跟咱们这儿管推理小说叫红皮书一个道理"
 },
 {
  "t0": 36.83,
  "t1": 39.3,
  "text": "拍《血之海滩》的导演马里奥·巴瓦"
 },
 {
  "t0": 39.34,
  "t1": 41.34,
  "text": "搁今天就是恐怖片圈的祖师爷"
 },
 {
  "t0": 41.38,
  "t1": 44.01,
  "text": "意大利哥特恐怖和铅黄片那套视觉语言"
 },
 {
  "t0": 44.05,
  "t1": 45.9,
  "text": "基本是他一个人打下的江山"
 },
 {
  "t0": 45.94,
  "t1": 47.48,
  "text": "可就是这么一位祖师爷"
 },
 {
  "t0": 47.52,
  "t1": 49.83,
  "text": "一辈子没挣到钱反倒欠了一屁股税"
 },
 {
  "t0": 49.87,
  "t1": 51.88,
  "text": "逼着他在一九七一年仓促开工"
 },
 {
  "t0": 51.92,
  "t1": 54.54,
  "text": "用最省的钱最快的速度拍了这么一部片"
 },
 {
  "t0": 54.56,
  "t1": 56.26,
  "text": "剧情一句话说清一片海湾"
 },
 {
  "t0": 56.3,
  "t1": 57.38,
  "text": "一块值钱的地皮"
 },
 {
  "t0": 57.42,
  "t1": 58.97,
  "text": "一堆人为了它互相残杀"
 },
 {
  "t0": 59.01,
  "t1": 59.78,
  "text": "开场五分钟"
 },
 {
  "t0": 59.82,
  "t1": 62.45,
  "text": "一个坐轮椅的老太在自家别墅里被勒死"
 },
 {
  "t0": 62.49,
  "t1": 64.04,
  "text": "凶手刚伪造完自杀现场"
 },
 {
  "t0": 64.08,
  "t1": 65.16,
  "text": "得意劲儿还没过"
 },
 {
  "t0": 65.2,
  "t1": 67.52,
  "text": "转头就被一个看不见的人给捅死了"
 },
 {
  "t0": 67.56,
  "t1": 68.96,
  "text": "杀人就跟接力赛似的"
 },
 {
  "t0": 69.0,
  "t1": 70.23,
  "text": "一场接一场往下传"
 },
 {
  "t0": 70.27,
  "t1": 71.82,
  "text": "全片一共十三个人嗝屁"
 },
 {
  "t0": 71.84,
  "t1": 74.72,
  "text": "这片子的意大利原名翻译过来叫连锁反应"
 },
 {
  "t0": 74.76,
  "t1": 77.0,
  "text": "你品品就是说贪婪跟生态圈一样"
 },
 {
  "t0": 77.04,
  "t1": 78.64,
  "text": "一环吃一环谁都跑不掉"
 },
 {
  "t0": 78.68,
  "t1": 80.6,
  "text": "中间有四个小年轻误闯进来"
 },
 {
  "t0": 80.64,
  "t1": 82.23,
  "text": "跟这事儿八竿子打不着"
 },
 {
  "t0": 82.27,
  "t1": 83.39,
  "text": "照样被顺手灭了"
 },
 {
  "t0": 83.43,
  "t1": 86.95,
  "text": "其中一个还是在海里游泳的时候被尸体吓了个半死"
 },
 {
  "t0": 86.99,
  "t1": 88.43,
  "text": "回头就被镰刀送走了"
 },
 {
  "t0": 88.45,
  "t1": 89.42,
  "text": "最绝的是结尾"
 },
 {
  "t0": 89.46,
  "t1": 91.55,
  "text": "拼到最后赢下遗产的那对夫妻"
 },
 {
  "t0": 91.59,
  "t1": 92.55,
  "text": "正抱着庆祝呢"
 },
 {
  "t0": 92.59,
  "t1": 95.17,
  "text": "被自家两个熊孩子当玩具开枪给崩了"
 },
 {
  "t0": 95.21,
  "t1": 96.81,
  "text": "小孩还以为爹妈在装死"
 },
 {
  "t0": 96.85,
  "t1": 98.3,
  "text": "开开心心跑出去玩了"
 },
 {
  "t0": 98.34,
  "t1": 100.27,
  "text": "你以为是侦探破案的悬疑片"
 },
 {
  "t0": 100.31,
  "t1": 101.28,
  "text": "看完你就知道"
 },
 {
  "t0": 101.32,
  "t1": 104.53,
  "text": "这片子压根没打算让任何人活着走出那片海湾"
 },
 {
  "t0": 104.57,
  "t1": 106.66,
  "text": "这片子最值钱的地方不在剧情"
 },
 {
  "t0": 106.7,
  "t1": 108.15,
  "text": "在它是怎么拍出来的"
 },
 {
  "t0": 108.19,
  "t1": 109.48,
  "text": "预算低到什么程度"
 },
 {
  "t0": 109.5,
  "t1": 111.05,
  "text": "巴瓦连摄影师都自己干"
 },
 {
  "t0": 111.09,
  "t1": 113.43,
  "text": "推轨镜头用的是小孩的玩具小推车"
 },
 {
  "t0": 113.47,
  "t1": 115.96,
  "text": "就这还拍出了后来被写进教材的运镜"
 },
 {
  "t0": 116.0,
  "t1": 118.03,
  "text": "杀人特效交给卡洛·兰巴尔迪"
 },
 {
  "t0": 118.07,
  "t1": 122.12,
  "text": "就是后来给《异形》和《E.T.》做特效拿奥斯卡的那位"
 },
 {
  "t0": 122.16,
  "t1": 123.56,
  "text": "他用蜡翻模做了假人"
 },
 {
  "t0": 123.6,
  "t1": 125.31,
  "text": "一刀下去血喷得又浓又艳"
 },
 {
  "t0": 125.35,
  "t1": 126.91,
  "text": "当年的观众哪见过这个"
 },
 {
  "t0": 126.95,
  "t1": 128.51,
  "text": "直接在电影院里看傻了"
 },
 {
  "t0": 128.53,
  "t1": 129.31,
  "text": "配乐也邪门"
 },
 {
  "t0": 129.35,
  "t1": 132.76,
  "text": "斯特维奥·奇普里亚尼写的是那种轻松的沙发音乐"
 },
 {
  "t0": 132.8,
  "t1": 134.04,
  "text": "画面里杀得血淋淋"
 },
 {
  "t0": 134.08,
  "t1": 135.63,
  "text": "音乐却甜得跟度假一样"
 },
 {
  "t0": 135.67,
  "t1": 137.99,
  "text": "这一手反差后来被无数恐怖片学走"
 },
 {
  "t0": 138.03,
  "t1": 138.65,
  "text": "成了标配"
 },
 {
  "t0": 138.69,
  "t1": 140.4,
  "text": "这片子在海外发行也折腾"
 },
 {
  "t0": 140.44,
  "t1": 141.99,
  "text": "美国发行商为了蹭热度"
 },
 {
  "t0": 142.03,
  "t1": 145.44,
  "text": "直接把它改名成《左边最后一栋房二》拿去影院放"
 },
 {
  "t0": 145.48,
  "t1": 147.65,
  "text": "实际上它比那部片还早拍了两年"
 },
 {
  "t0": 147.67,
  "t1": 150.38,
  "text": "一九七一年在法国阿沃里亚兹电影节首映"
 },
 {
  "t0": 150.42,
  "t1": 152.68,
  "text": "主办方请了克里斯托弗·李来捧场"
 },
 {
  "t0": 152.72,
  "t1": 154.53,
  "text": "老爷子看完直接黑着脸离席"
 },
 {
  "t0": 154.57,
  "t1": 155.63,
  "text": "据说被恶心坏了"
 },
 {
  "t0": 155.67,
  "t1": 156.12,
  "text": "你想想"
 },
 {
  "t0": 156.16,
  "t1": 158.57,
  "text": "连演过德古拉伯爵的人都被恶心跑了"
 },
 {
  "t0": 158.61,
  "t1": 160.12,
  "text": "当年的杀伤力得有多大"
 },
 {
  "t0": 160.14,
  "t1": 161.85,
  "text": "重头戏在这儿十年之后"
 },
 {
  "t0": 161.89,
  "t1": 164.62,
  "text": "美国出了部电影叫《十三号星期五》"
 },
 {
  "t0": 164.66,
  "t1": 166.54,
  "text": "火遍全球连出十二部续集"
 },
 {
  "t0": 166.58,
  "t1": 167.95,
  "text": "里面有两段杀人戏"
 },
 {
  "t0": 167.99,
  "t1": 170.55,
  "text": "钩刀劈脸长矛串起床上的一对情侣"
 },
 {
  "t0": 170.59,
  "t1": 172.47,
  "text": "几乎是照抄《血之海滩》"
 },
 {
  "t0": 172.51,
  "t1": 175.08,
  "text": "有影评人把两部片子并排逐帧对比"
 },
 {
  "t0": 175.12,
  "t1": 176.82,
  "text": "结论就四个字抄作业了"
 },
 {
  "t0": 176.84,
  "t1": 179.33,
  "text": "而且《十三号星期五》还真不是个例"
 },
 {
  "t0": 179.37,
  "t1": 181.54,
  "text": "整个八十年代美国的砍杀片浪潮"
 },
 {
  "t0": 181.58,
  "t1": 184.22,
  "text": "封闭的营地一群年轻炮灰花式杀人机关"
 },
 {
  "t0": 184.26,
  "t1": 185.81,
  "text": "走的全是这部片的模板"
 },
 {
  "t0": 185.85,
  "t1": 189.42,
  "text": "后来的《惊声尖叫》《我知道你去年夏天干了什么》"
 },
 {
  "t0": 189.46,
  "t1": 190.85,
  "text": "往上溯源都绕不开它"
 },
 {
  "t0": 190.89,
  "t1": 192.75,
  "text": "独立连线评影史百大恐怖片"
 },
 {
  "t0": 192.79,
  "t1": 193.72,
  "text": "它排第九十四"
 },
 {
  "t0": 193.76,
  "t1": 195.63,
  "text": "所以这部片到底算不算烂片"
 },
 {
  "t0": 195.65,
  "t1": 198.1,
  "text": "讲良心话它的剧情是真的乱七八糟"
 },
 {
  "t0": 198.14,
  "t1": 199.95,
  "text": "人物多到记不住杀来杀去"
 },
 {
  "t0": 199.99,
  "t1": 201.63,
  "text": "你最后都不知道谁图啥"
 },
 {
  "t0": 201.67,
  "t1": 203.8,
  "text": "可人家巴瓦要的根本不是剧情"
 },
 {
  "t0": 203.84,
  "t1": 206.62,
  "text": "他要的是把杀人做成一件有设计感的事"
 },
 {
  "t0": 206.66,
  "t1": 208.3,
  "text": "十三场谋杀场场不重样"
 },
 {
  "t0": 208.34,
  "t1": 210.8,
  "text": "这门手艺后来的导演们学了一辈子"
 },
 {
  "t0": 210.84,
  "t1": 212.64,
  "text": "烂片指数十分为满分的话"
 },
 {
  "t0": 212.68,
  "t1": 213.67,
  "text": "本片我给三分"
 },
 {
  "t0": 213.71,
  "t1": 216.16,
  "text": "扣的七分全扣在剧情上剩下的三分"
 },
 {
  "t0": 216.2,
  "t1": 217.52,
  "text": "是给创意和胆子的"
 },
 {
  "t0": 217.54,
  "t1": 219.48,
  "text": "好了我要去遛狗了白了个白"
 }
]