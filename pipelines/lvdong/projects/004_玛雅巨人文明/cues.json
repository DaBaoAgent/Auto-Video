[
 {
  "t0": 0.0,
  "t1": 2.3,
  "text": "全世界那么多古文明，只有一个看起来"
 },
 {
  "t0": 2.3,
  "t1": 5.06,
  "text": "像被人托管过，玛雅。它把一年算成三百"
 },
 {
  "t0": 5.06,
  "t1": 7.62,
  "text": "六十五天多一点点。可它的农业还停留在"
 },
 {
  "t0": 7.62,
  "t1": 9.87,
  "text": "刀耕火种，没有铁犁，没有灌溉"
 },
 {
  "t0": 9.87,
  "t1": 11.88,
  "text": "它能修出结构复杂的石头金字塔"
 },
 {
  "t0": 11.88,
  "t1": 15.3,
  "text": "老百姓住的却是泥巴糊墙、野草遮顶的窝棚"
 },
 {
  "t0": 15.3,
  "t1": 19.08,
  "text": "文明头尾差了两个时代，本身就离谱。这桩悬案"
 },
 {
  "t0": 19.08,
  "t1": 22.56,
  "text": "正经名字叫\"被托管过的文明\"。在所有古文明里"
 },
 {
  "t0": 22.56,
  "t1": 25.38,
  "text": "玛雅是唯一一个怎么想都不像自己长出来的"
 },
 {
  "t0": 25.38,
  "t1": 28.18,
  "text": "怀疑从一件文物开始。一九三九年"
 },
 {
  "t0": 28.18,
  "t1": 29.88,
  "text": "美国考古学家马修斯特林"
 },
 {
  "t0": 29.88,
  "t1": 33.04,
  "text": "在墨西哥韦拉克鲁斯南边挖出一块C号石碑"
 },
 {
  "t0": 33.04,
  "t1": 36.44,
  "text": "石碑中间竖着一排符号，像易经的八卦"
 },
 {
  "t0": 36.44,
  "t1": 38.52,
  "text": "马修拿它对照成熟的玛雅文字"
 },
 {
  "t0": 38.52,
  "t1": 42.25,
  "text": "发现这些符号在玛雅文里全是偏旁。诡异的是"
 },
 {
  "t0": 42.28,
  "t1": 45.04,
  "text": "文字要真有雏形，一定会有从粗糙到成型的"
 },
 {
  "t0": 45.04,
  "t1": 47.6,
  "text": "变形过程。可这些符号跟发展了好几个"
 },
 {
  "t0": 47.6,
  "t1": 50.3,
  "text": "世纪的玛雅文字长得一模一样，一点没变"
 },
 {
  "t0": 50.3,
  "t1": 53.81,
  "text": "像有人拿着成品零件，直接塞进了玛雅的仓库"
 }
]