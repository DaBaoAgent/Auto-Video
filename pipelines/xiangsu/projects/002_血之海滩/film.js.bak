}
function cliffRight() {
  poly([[466, 340], [478, 276], [498, 250], [530, 240], [562, 246], [592, 262], [660, 262], [660, 340]], P.e0);
  poly([[478, 276], [498, 250], [530, 240], [562, 246], [552, 258], [512, 268], [492, 288]], P.e1);
  poly([[562, 246], [592, 262], [660, 262], [660, 316], [588, 306]], P.e2);
