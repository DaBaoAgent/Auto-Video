function boat(x, y) {
  poly([[x - 19, y], [x + 19, y], [x + 13, y + 7], [x - 13, y + 7]], P.e0);
  hline(x - 17, y, 34, P.cream);
  poly([[x - 1, y - 24], [x - 1, y - 3], [x + 9, y - 7]], P.cream);
