{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["acts"],
  "properties": {
    "acts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "title", "dur", "env"],
        "properties": {
          "key": { "type": "string" },
          "era": { "type": "string" },
          "title": { "type": "string" },
          "dur": { "type": "number" },
          "env": { "type": "string" },
          "narr": { "type": "string" },
          "summary": { "type": "string" },
          "hold": { "type": "boolean" },
          "reset": { "type": "boolean" },
          "baseline": { "type": "array", "items": { "type": "object" } },
          "sourceKind": { "enum": ["史载", "演义辨析", "历史文化", "讲述"] },
          "featured": { "type": "array", "maxItems": 2, "items": { "type": "string" } },
          "power": { "type": "object" },
          "shots": { "type": "array" },
          "set": { "type": "object" },
          "march": { "type": "array" },
          "events": { "type": "array" },
          "cards": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "object",
              "required": ["kind", "at"],
              "properties": {
                "kind": { "enum": ["quote", "timeline", "windrose", "letter", "seal"] },
                "at": { "type": "number" },
                "life": { "type": "number" },
                "slot": { "enum": ["C", "U", "L", "R"] },
                "text": { "type": "string" },
                "src": { "type": "string" },
                "title": { "type": "string" },
                "caption": { "type": "string" },
                "sig": { "type": "string" },
                "seal": { "type": "string" },
                "vert": { "type": "boolean" },
                "bearing": { "type": "number" },
                "items": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
              }
            }
          },
          "strat": { "type": "object" },
          "scrubSet": { "type": "object" },
          "finale": { "type": "number" },
          "fx": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["at", "type"],
              "properties": {
                "at": { "type": "number" },
                "type": { "enum": ["volley", "ignite", "shake", "campFire", "flood", "splash", "spray", "embers", "debris"] }
              }
            }
          }
        }
      }
    }
  }
}
