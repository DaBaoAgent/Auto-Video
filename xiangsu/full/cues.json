  "subs": [
    {
      "t0": 0,
      "t1": 1,
      "text": "一群出土的雕像",
      "hl": "出土"
    },
    {
      "t0": 1.32,
      "t1": 2.54,
      "text": "穿着教皇一样的衣服",
      "hl": "教皇"
    },
    {
      "t0": 2.56,
      "t1": 3.46,
      "text": "却套着鱼皮",
      "hl": "鱼皮"
    },
    {
      "t0": 3.66,
      "t1": 4.86,
      "text": "四千年前的苏美尔人",
      "hl": "苏美尔"
    },
    {
      "t0": 4.96,
      "t1": 5.695,
      "text": "管他们叫神",
      "hl": "叫神"
    },
    {
      "t0": 5.7,
      "t1": 6.6,
      "text": "但你要问他们",
      "hl": "问他们"
    },
    {
      "t0": 6.96,
      "t1": 7.655,
      "text": "神是怎么来的",
      "hl": "怎么来"
    },
    {
      "t0": 7.66,
      "t1": 8.58,
      "text": "他们会告诉你",
      "hl": "告诉你"
    },
    {
      "t0": 8.6,
      "t1": 10.08,
      "text": "是一位半人半鱼的怪物",
      "hl": "半人半鱼"
    },
    {
      "t0": 10.1,
      "t1": 11.48,
      "text": "从波斯湾里爬了出来",
      "hl": "波斯湾"
    },
    {
      "t0": 11.72,
      "t1": 13,
      "text": "白天上岸教人盖庙",
      "hl": "盖庙"
    },
    {
      "t0": 13.02,
      "t1": 13.78,
      "text": "编法律",
      "hl": "法律"
    },
    {
      "t0": 14.06,
      "t1": 15.24,
      "text": "搞农业 算几何",
      "hl": "农业"
    },
    {
      "t0": 15.26,
      "t1": 16.52,
      "text": "晚上再游回深海",
      "hl": "深海"
    },
    {
      "t0": 16.7,
      "t1": 17.32,
      "text": "自打那以后",
      "hl": "自打那以后"
    },
    {
      "t0": 17.34,
      "t1": 18.26,
      "text": "人类的知识",
      "hl": "知识"
    },
    {
      "t0": 18.4,
      "t1": 19.835,
      "text": "再也没超过这条鱼的传授",
      "hl": "传授"
    },
    {
      "t0": 19.84,
      "t1": 20.763,
      "text": "你品品",
      "hl": "品品"
    },
    {
      "t0": 20.9,
      "t1": 22.895,
      "text": "这大概是全世界最古老的都市传说",
      "hl": "都市传说"
    },
    {
      "t0": 22.9,
      "t1": 24.03,
      "text": "其实这桩悬案",
      "hl": "悬案"
    },
    {
      "t0": 24.18,
      "t1": 25.66,
      "text": "后来还真有个正经名字",
      "hl": "正经名字"
    },
    {
      "t0": 25.68,
      "t1": 26.875,
      "text": "叫波斯湾绿洲假说",
      "hl": "绿洲假说"
    },
    {
      "t0": 26.88,
      "t1": 27.64,
      "text": "一百多年前",
      "hl": "一百多年"
    },
    {
      "t0": 27.94,
      "t1": 29.48,
      "text": "一位语言天才连推了三步",
      "hl": "语言天才"
    },
    {
      "t0": 29.5,
      "t1": 31.055,
      "text": "就把这事儿推成了一个大瓜",
      "hl": "大瓜"
    },
    {
      "t0": 31.06,
      "t1": 31.74,
      "text": "第一步",
      "hl": "第一步"
    },
    {
      "t0": 31.92,
      "t1": 33.88,
      "text": "他琢磨着这鱼头神哪是什么怪物",
      "hl": "鱼头神"
    },
    {
      "t0": 33.9,
      "t1": 36.08,
      "text": "分明是一群精通航海的高等文明",
      "hl": "高等文明"
    },
    {
      "t0": 36.233,
      "t1": 36.74,
      "text": "驾着船",
      "hl": "驾着船"
    },
    {
      "t0": 37.04,
      "t1": 38.68,
      "text": "带着成熟的文字和灌溉技术",
      "hl": "文字"
    },
    {
      "t0": 38.7,
      "t1": 39.8,
      "text": "从波斯湾北上",
      "hl": "波斯湾"
    },
    {
      "t0": 40.02,
      "t1": 40.855,
      "text": "在苏美尔登陆",
      "hl": "苏美尔"
    },
    {
      "t0": 40.86,
      "t1": 42.12,
      "text": "一群科技先进",
      "hl": "科技先进"
    },
    {
      "t0": 42.4,
      "t1": 43.42,
      "text": "从海里冒出来的人",
      "hl": "冒出来"
    },
    {
      "t0": 43.44,
      "t1": 44.58,
      "text": "对当地土著来说",
      "hl": "土著"
    },
    {
      "t0": 44.76,
      "t1": 45.56,
      "text": "不就是神吗",
      "hl": "神吗"
    },
    {
      "t0": 45.62,
      "t1": 46.74,
      "text": "可第二步就说不通了",
      "hl": "第二步"
    },
    {
      "t0": 46.76,
      "t1": 47.84,
      "text": "这群人的家在哪",
      "hl": "家在哪"
    },
    {
      "t0": 48.12,
      "t1": 49.44,
      "text": "考古界压根没挖到过",
      "hl": "考古界"
    },
    {
      "t0": 49.7,
      "t1": 50.975,
      "text": "比苏美尔更老的文明",
      "hl": "苏美尔"
    },
    {
      "t0": 50.98,
      "t1": 51.46,
      "text": "除非",
      "hl": "除非"
    },
    {
      "t0": 51.48,
      "t1": 53.1,
      "text": "波斯湾以前根本不是海",
      "hl": "波斯湾"
    },
    {
      "t0": 53.12,
      "t1": 55.12,
      "text": "他们一夜之间家园被海水吞没",
      "hl": "吞没"
    },
    {
      "t0": 55.14,
      "t1": 56.89,
      "text": "才驾船逃上美索不达米亚",
      "hl": "美索不达米亚"
    },
    {
      "t0": 57,
      "t1": 59.08,
      "text": "搁今天 这就是标准的我猜的",
      "hl": "搁今天"
    },
    {
      "t0": 59.1,
      "t1": 59.94,
      "text": "但我有证据",
      "hl": "证据"
    },
    {
      "t0": 60.1,
      "t1": 60.895,
      "text": "证据还真不少",
      "hl": "证据"
    },
    {
      "t0": 60.9,
      "t1": 62.06,
      "text": "语言学家发现",
      "hl": "语言学家"
    },
    {
      "t0": 62.08,
      "t1": 64.26,
      "text": "苏美尔语跟世界上任何语言都",
      "hl": "苏美尔"
    },
    {
      "t0": 64.28,
      "t1": 65.14,
      "text": "没有亲缘关系",
      "hl": "亲缘关系"
    },
    {
      "t0": 65.16,
      "t1": 67.68,
      "text": "连他们主要城市的名字都不是苏美尔语",
      "hl": "苏美尔"
    },
    {
      "t0": 67.7,
      "t1": 69.035,
      "text": "是前人留下的定居点",
      "hl": "定居点"
    },
    {
      "t0": 69.04,
      "t1": 69.98,
      "text": "更邪门的是",
      "hl": "邪门"
    },
    {
      "t0": 70.25,
      "t1": 71.22,
      "text": "犁 农夫",
      "hl": "农夫"
    },
    {
      "t0": 71.39,
      "t1": 73.3,
      "text": "播种 这些最核心的农业词汇",
      "hl": "农业词汇"
    },
    {
      "t0": 73.32,
      "t1": 74.235,
      "text": "全是外来语",
      "hl": "外来语"
    },
    {
      "t0": 74.24,
      "t1": 75.72,
      "text": "一个靠种地起家的民族",
      "hl": "种地"
    },
    {
      "t0": 75.9,
      "t1": 77.6,
      "text": "干农活的词竟然全是借来的",
      "hl": "借来的"
    },
    {
      "t0": 77.62,
      "t1": 78.3,
      "text": "这说明啥",
      "hl": "说明啥"
    },
    {
      "t0": 78.7,
      "t1": 80.735,
      "text": "说明他们是后来搬来的",
      "hl": "后来"
    },
    {
      "t0": 80.74,
      "t1": 82.16,
      "text": "他们自己的神话里说",
      "hl": "神话"
    },
    {
      "t0": 82.18,
      "t1": 84.26,
      "text": "祖先来自一个叫迪尔蒙的天堂岛",
      "hl": "迪尔蒙"
    },
    {
      "t0": 84.28,
      "t1": 85.04,
      "text": "考古破解",
      "hl": "考古破解"
    },
    {
      "t0": 85.06,
      "t1": 86.34,
      "text": "就是今天的巴林岛",
      "hl": "巴林"
    },
    {
      "t0": 86.42,
      "t1": 87.2,
      "text": "二零二一年",
      "hl": "二零二一"
    },
    {
      "t0": 87.22,
      "t1": 88.88,
      "text": "科学家从现代人的基因里",
      "hl": "科学家"
    },
    {
      "t0": 88.98,
      "t1": 90.28,
      "text": "硬算出一支幽灵人群",
      "hl": "幽灵人群"
    },
    {
      "t0": 90.43,
      "t1": 92.18,
      "text": "六万年前刚走出非洲就",
      "hl": "六万年前"
    },
    {
      "t0": 92.2,
      "t1": 93.27,
      "text": "跟大部队分道扬镳",
      "hl": "分道扬镳"
    },
    {
      "t0": 93.3,
      "t1": 94.56,
      "text": "独自藏了五万年",
      "hl": "独自"
    },
    {
      "t0": 94.58,
      "t1": 95.775,
      "text": "没留下过一具遗骸",
      "hl": "遗骸"
    },
    {
      "t0": 95.78,
      "t1": 98.26,
      "text": "拿尼安德特人的基因比例当探针一照",
      "hl": "尼安德特人"
    },
    {
      "t0": 98.28,
      "t1": 99.2,
      "text": "波斯湾沿岸",
      "hl": "波斯湾"
    },
    {
      "t0": 99.22,
      "t1": 100.643,
      "text": "尼人血统几乎为零",
      "hl": "血统"
    },
    {
      "t0": 100.767,
      "t1": 102.16,
      "text": "八成就是他们隐居的地方",
      "hl": "隐居"
    },
    {
      "t0": 102.18,
      "t1": 103.52,
      "text": "也就是史前那片绿洲",
      "hl": "史前"
    },
    {
      "t0": 103.672,
      "t1": 105.84,
      "text": "一九九四年航天飞机扫描显示",
      "hl": "一九九四"
    },
    {
      "t0": 105.86,
      "t1": 107.88,
      "text": "那地方当年有四条大河汇入",
      "hl": "四条大河"
    },
    {
      "t0": 108.07,
      "t1": 109.04,
      "text": "两条今天还在",
      "hl": "两条"
    },
    {
      "t0": 109.21,
      "t1": 110.115,
      "text": "两条早干了",
      "hl": "两条"
    },
    {
      "t0": 110.12,
      "t1": 111.06,
      "text": "四条大河",
      "hl": "四条大河"
    },
    {
      "t0": 111.38,
      "t1": 112.02,
      "text": "四面环山",
      "hl": "四面环山"
    },
    {
      "t0": 112.28,
      "t1": 113.155,
      "text": "这不就是伊甸园吗",
      "hl": "伊甸园"
    },
    {
      "t0": 113.16,
      "t1": 114.24,
      "text": "但那么大一片绿洲",
      "hl": "绿洲"
    },
    {
      "t0": 114.54,
      "t1": 116.1,
      "text": "洪水是怎么把它整个灌没的",
      "hl": "洪水"
    },
    {
      "t0": 116.228,
      "t1": 117.06,
      "text": "二零一零年",
      "hl": "二零一零"
    },
    {
      "t0": 117.26,
      "t1": 118.98,
      "text": "考古学家罗斯接了这案子",
      "hl": "考古学家"
    },
    {
      "t0": 119,
      "t1": 120.41,
      "text": "他的思路特别反常识",
      "hl": "反常识"
    },
    {
      "t0": 120.54,
      "t1": 121.12,
      "text": "先告诉你",
      "hl": "告诉你"
    },
    {
      "t0": 121.14,
      "t1": 122.86,
      "text": "我们现在还活在冰河期里",
      "hl": "冰河期"
    },
    {
      "t0": 122.94,
      "t1": 124.72,
      "text": "地球四十五亿年历史",
      "hl": "四十五亿"
    },
    {
      "t0": 124.867,
      "t1": 126.82,
      "text": "百分之九十的时间压根没有冰盖",
      "hl": "冰盖"
    },
    {
      "t0": 126.96,
      "t1": 128.64,
      "text": "冰盖就是地球的水银行",
      "hl": "水银行"
    },
    {
      "t0": 128.66,
      "t1": 129.423,
      "text": "冰越厚",
      "hl": "冰越厚"
    },
    {
      "t0": 129.6,
      "t1": 130.28,
      "text": "海平面越低",
      "hl": "海平面"
    },
    {
      "t0": 130.44,
      "t1": 132,
      "text": "一万多年前的末次冰盛期",
      "hl": "末次冰盛期"
    },
    {
      "t0": 132.02,
      "t1": 134.26,
      "text": "北美压着三公里厚的劳伦泰德冰盖",
      "hl": "劳伦泰德"
    },
    {
      "t0": 134.28,
      "t1": 137.135,
      "text": "全球海平面比现在低了整整一百二十米",
      "hl": "一百二十米"
    },
    {
      "t0": 137.14,
      "t1": 138.6,
      "text": "而波斯湾平均水深",
      "hl": "波斯湾"
    },
    {
      "t0": 138.62,
      "t1": 139.735,
      "text": "只有三十五米",
      "hl": "三十五米"
    },
    {
      "t0": 139.74,
      "t1": 140.34,
      "text": "说白了",
      "hl": "说白了"
    },
    {
      "t0": 140.44,
      "t1": 141.82,
      "text": "过去两百万年的冰河期里",
      "hl": "两百万年"
    },
    {
      "t0": 141.93,
      "t1": 142.78,
      "text": "波斯湾的常态",
      "hl": "波斯湾"
    },
    {
      "t0": 142.8,
      "t1": 144.34,
      "text": "就是一大块裸露的陆地",
      "hl": "裸露的陆地"
    },
    {
      "t0": 144.36,
      "t1": 145.72,
      "text": "面积顶六七个台湾",
      "hl": "台湾"
    },
    {
      "t0": 145.9,
      "t1": 146.85,
      "text": "底下是碳酸盐岩",
      "hl": "碳酸盐岩"
    },
    {
      "t0": 146.92,
      "t1": 148.2,
      "text": "四周全是高原",
      "hl": "高原"
    },
    {
      "t0": 148.5,
      "t1": 150.24,
      "text": "地下水被挤成无数泉眼往上冒",
      "hl": "地下水"
    },
    {
      "t0": 150.26,
      "t1": 152.22,
      "text": "巴林这个词在阿拉伯语里",
      "hl": "巴林"
    },
    {
      "t0": 152.24,
      "t1": 153.195,
      "text": "就是两头海的意思",
      "hl": "两头海"
    },
    {
      "t0": 153.2,
      "t1": 153.98,
      "text": "淡水不缺",
      "hl": "淡水"
    },
    {
      "t0": 154.21,
      "t1": 154.88,
      "text": "大河汇入",
      "hl": "大河汇入"
    },
    {
      "t0": 154.9,
      "t1": 156.335,
      "text": "这地方过去真是片绿洲",
      "hl": "绿洲"
    },
    {
      "t0": 156.34,
      "t1": 156.92,
      "text": "后来",
      "hl": "后来"
    },
    {
      "t0": 157.08,
      "t1": 158.2,
      "text": "一万两千九百年前",
      "hl": "一万两千九百"
    },
    {
      "t0": 158.52,
      "t1": 159.475,
      "text": "新仙女木事件",
      "hl": "新仙女木"
    },
    {
      "t0": 159.48,
      "t1": 160.915,
      "text": "北美大冰湖溃坝",
      "hl": "冰湖"
    },
    {
      "t0": 161.06,
      "t1": 162.42,
      "text": "巨量淡水冲进大西洋",
      "hl": "大西洋"
    },
    {
      "t0": 162.44,
      "t1": 164.54,
      "text": "把全球的暖气片温盐环流掐断",
      "hl": "温盐环流"
    },
    {
      "t0": 164.71,
      "t1": 165.375,
      "text": "气温骤降",
      "hl": "气温骤降"
    },
    {
      "t0": 165.38,
      "t1": 166.42,
      "text": "沙漠越来越干",
      "hl": "沙漠"
    },
    {
      "t0": 166.6,
      "t1": 167.94,
      "text": "四周族群为了活命",
      "hl": "族群"
    },
    {
      "t0": 167.96,
      "t1": 170.78,
      "text": "全往唯一还有水有泉眼的波斯湾绿洲跑",
      "hl": "波斯湾"
    },
    {
      "t0": 171.12,
      "t1": 173.48,
      "text": "四面八方的最强者带着各部族的",
      "hl": "四面八方"
    },
    {
      "t0": 173.5,
      "t1": 174.66,
      "text": "顶尖技术凑到一块儿",
      "hl": "顶尖技术"
    },
    {
      "t0": 174.68,
      "t1": 175.5,
      "text": "像炼丹一样",
      "hl": "炼丹"
    },
    {
      "t0": 175.8,
      "t1": 176.755,
      "text": "把前文明炼了出来",
      "hl": "前文明"
    },
    {
      "t0": 176.76,
      "t1": 178.12,
      "text": "然后八千二百年前",
      "hl": "八千二百年"
    },
    {
      "t0": 178.14,
      "t1": 180.315,
      "text": "那个超级冰湖终于绷不住了",
      "hl": "绷不住"
    },
    {
      "t0": 180.32,
      "t1": 180.98,
      "text": "据估算",
      "hl": "据估算"
    },
    {
      "t0": 181.22,
      "t1": 183.1,
      "text": "它的水量至少是当年米苏拉湖的",
      "hl": "米苏拉湖"
    },
    {
      "t0": 183.185,
      "t1": 183.66,
      "text": "七十八倍",
      "hl": "七十八倍"
    },
    {
      "t0": 183.68,
      "t1": 185.595,
      "text": "能把整个中国淹上十七米",
      "hl": "十七米"
    },
    {
      "t0": 185.6,
      "t1": 186.14,
      "text": "海平面",
      "hl": "海平面"
    },
    {
      "t0": 186.16,
      "t1": 186.98,
      "text": "一波波往上跳",
      "hl": "一波波"
    },
    {
      "t0": 187,
      "t1": 189.42,
      "text": "最终冲垮了霍尔木兹海峡那座基什山",
      "hl": "霍尔木兹海峡"
    },
    {
      "t0": 189.44,
      "t1": 190.3,
      "text": "海水倒灌",
      "hl": "倒灌"
    },
    {
      "t0": 190.54,
      "t1": 191.2,
      "text": "整片绿洲",
      "hl": "绿洲"
    },
    {
      "t0": 191.22,
      "t1": 192.755,
      "text": "一夜之间变成了波斯湾",
      "hl": "波斯湾"
    },
    {
      "t0": 192.76,
      "t1": 194.84,
      "text": "你再看苏美尔人自己写的创世纪",
      "hl": "苏美尔"
    },
    {
      "t0": 194.86,
      "t1": 196.44,
      "text": "众神早知道洪水要来",
      "hl": "众神"
    },
    {
      "t0": 196.46,
      "t1": 197.6,
      "text": "自己却被冲得狼狈",
      "hl": "狼狈"
    },
    {
      "t0": 197.62,
      "t1": 199.335,
      "text": "洪水退后还能跟人类生孩子",
      "hl": "洪水"
    },
    {
      "t0": 199.34,
      "t1": 200.08,
      "text": "说白了",
      "hl": "说白了"
    },
    {
      "t0": 200.1,
      "t1": 201.72,
      "text": "这众神不就是一群科技",
      "hl": "众神"
    },
    {
      "t0": 201.74,
      "t1": 203.515,
      "text": "比人类高一大截的前文明吗",
      "hl": "前文明"
    },
    {
      "t0": 203.52,
      "t1": 204.92,
      "text": "他们算得出基什山要崩",
      "hl": "基什山"
    },
    {
      "t0": 204.94,
      "t1": 206.195,
      "text": "算得出大限将至",
      "hl": "大限"
    },
    {
      "t0": 206.28,
      "t1": 207.12,
      "text": "但拦不住",
      "hl": "拦不住"
    },
    {
      "t0": 207.14,
      "t1": 207.96,
      "text": "于是开了个会",
      "hl": "开了个会"
    },
    {
      "t0": 207.98,
      "t1": 209.095,
      "text": "决定瞒着人类",
      "hl": "瞒着人类"
    },
    {
      "t0": 209.1,
      "t1": 210.82,
      "text": "只有智慧之神恩基泄了密",
      "hl": "恩基"
    },
    {
      "t0": 210.84,
      "t1": 212.515,
      "text": "人类造了方舟逃过一劫",
      "hl": "方舟"
    },
    {
      "t0": 212.52,
      "t1": 213.66,
      "text": "这段洪水故事",
      "hl": "洪水"
    },
    {
      "t0": 213.68,
      "t1": 215.48,
      "text": "细节跟圣经几乎一模一样",
      "hl": "圣经"
    },
    {
      "t0": 215.5,
      "t1": 217.275,
      "text": "却比圣经早了一千多年",
      "hl": "圣经"
    },
    {
      "t0": 217.28,
      "t1": 218.06,
      "text": "洪水以后",
      "hl": "洪水"
    },
    {
      "t0": 218.08,
      "t1": 220.38,
      "text": "幸存的人和神搭伙过日子",
      "hl": "幸存"
    },
    {
      "t0": 220.4,
      "t1": 221.64,
      "text": "海平面又涨了几百年",
      "hl": "海平面"
    },
    {
      "t0": 221.66,
      "t1": 223.355,
      "text": "家园一座接一座变成孤岛",
      "hl": "孤岛"
    },
    {
      "t0": 223.36,
      "t1": 224.56,
      "text": "直到六千五百年前",
      "hl": "六千五百年"
    },
    {
      "t0": 224.58,
      "t1": 225.92,
      "text": "北美冰盖化完",
      "hl": "冰盖"
    },
    {
      "t0": 225.94,
      "t1": 227.44,
      "text": "他们只好穿着鱼头装",
      "hl": "鱼头装"
    },
    {
      "t0": 227.46,
      "t1": 229.78,
      "text": "去两河流域教新居民种地",
      "hl": "两河流域"
    },
    {
      "t0": 229.96,
      "t1": 230.935,
      "text": "盖庙 写字",
      "hl": "盖庙"
    },
    {
      "t0": 230.94,
      "t1": 232.54,
      "text": "苏美尔文明就这么诞生的",
      "hl": "苏美尔"
    },
    {
      "t0": 232.56,
      "t1": 234.075,
      "text": "一出生就满身黑科技",
      "hl": "黑科技"
    },
    {
      "t0": 234.08,
      "t1": 235.7,
      "text": "连那份邪门的苏美尔王表",
      "hl": "苏美尔王表"
    },
    {
      "t0": 235.72,
      "t1": 237.16,
      "text": "都能用这个假说解释",
      "hl": "假说"
    },
    {
      "t0": 237.18,
      "t1": 238.34,
      "text": "洪水前的国王",
      "hl": "洪水"
    },
    {
      "t0": 238.36,
      "t1": 239.68,
      "text": "动不动在位几万年",
      "hl": "几万年"
    },
    {
      "t0": 239.7,
      "t1": 240.84,
      "text": "一过洪水这条线",
      "hl": "洪水"
    },
    {
      "t0": 240.86,
      "t1": 241.96,
      "text": "就变回几十年",
      "hl": "变回"
    },
    {
      "t0": 241.98,
      "t1": 243.375,
      "text": "十几年的正常人类",
      "hl": "正常人类"
    },
    {
      "t0": 243.38,
      "t1": 244.18,
      "text": "考古学家说",
      "hl": "考古学家"
    },
    {
      "t0": 244.2,
      "t1": 245.6,
      "text": "那是文明被淹前的记忆",
      "hl": "文明"
    },
    {
      "t0": 245.62,
      "t1": 246.56,
      "text": "故事讲到这",
      "hl": "讲到这"
    },
    {
      "t0": 246.58,
      "t1": 247.84,
      "text": "还有个最挠人的点",
      "hl": "挠人"
    },
    {
      "t0": 247.86,
      "t1": 249.62,
      "text": "苏美尔文明最终灭亡",
      "hl": "苏美尔"
    },
    {
      "t0": 249.64,
      "t1": 251.24,
      "text": "科学家挖出来的原因是",
      "hl": "科学家"
    },
    {
      "t0": 251.26,
      "t1": 253.31,
      "text": "一场持续三百年的超级干旱",
      "hl": "超级干旱"
    },
    {
      "t0": 253.4,
      "t1": 255.315,
      "text": "源头又是温盐环流突然减弱",
      "hl": "温盐环流"
    },
    {
      "t0": 255.32,
      "t1": 256.1,
      "text": "可这一次",
      "hl": "可这一次"
    },
    {
      "t0": 256.12,
      "t1": 257.5,
      "text": "北美冰盖早化完了",
      "hl": "冰盖"
    },
    {
      "t0": 257.69,
      "t1": 258.595,
      "text": "它凭什么减弱",
      "hl": "凭什么"
    },
    {
      "t0": 258.6,
      "t1": 259.495,
      "text": "没人说得清",
      "hl": "说得清"
    },
    {
      "t0": 259.5,
      "t1": 260.915,
      "text": "地球这场感冒还没好",
      "hl": "感冒"
    },
    {
      "t0": 260.92,
      "t1": 261.56,
      "text": "专家说",
      "hl": "专家"
    },
    {
      "t0": 261.58,
      "t1": 263.82,
      "text": "如果冰盖真按历史常态化完",
      "hl": "常态化"
    },
    {
      "t0": 263.84,
      "t1": 265.36,
      "text": "海平面还得再涨七十米",
      "hl": "海平面"
    },
    {
      "t0": 265.47,
      "t1": 267.72,
      "text": "搁今天 谁也不敢说我们现在站的地方",
      "hl": "搁今天"
    },
    {
      "t0": 267.74,
      "t1": 269.575,
      "text": "以后会不会也变成谁的伊甸园",
      "hl": "伊甸园"
    },
    {
      "t0": 269.62,
      "t1": 270.36,
      "text": "我是艾伦",
      "hl": "艾伦"
    },
    {
      "t0": 270.51,
      "t1": 271.02,
      "text": "遛狗去了",
      "hl": "遛狗"
    },
    {
      "t0": 271.04,
      "t1": 271.7,
      "text": "白了个白",
      "hl": "白了个白"
    }
  ],
