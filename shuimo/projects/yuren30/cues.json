  "captions": [
    { "t0": 0.00, "t1": 0.74, "text": "一九八三年" },
    { "t0": 0.74, "t1": 1.78, "text": "广州工人在象岗山" },
    { "t0": 1.78, "t1": 3.59, "text": "一铲子挖出一只黑匣子" },
    { "t0": 3.59, "t1": 4.88, "text": "里面装着非洲象牙" },
    { "t0": 4.90, "t1": 5.66, "text": "波斯药盒" },
    { "t0": 5.72, "t1": 6.74, "text": "两公斤矿石药" },
    { "t0": 6.74, "t1": 7.30, "text": "还有一套" },
    { "t0": 7.30, "t1": 8.83, "text": "能把人封进玉石里的衣服" },
    { "t0": 8.83, "t1": 9.84, "text": "顺着线索往南" },
    { "t0": 9.84, "t1": 11.43, "text": "最后会撞进南极冰盖下" },
    { "t0": 11.43, "t1": 13.16, "text": "一条消失了几千万年的河" },
    { "t0": 13.38, "t1": 13.97, "text": "那年六月" },
    { "t0": 13.97, "t1": 15.88, "text": "象岗山已经被削了三年" },
    { "t0": 15.88, "t1": 17.18, "text": "将近五十米的山头" },
    { "t0": 17.18, "t1": 18.32, "text": "只剩三十多米" },
    { "t0": 18.32, "t1": 19.94, "text": "工人们给宿舍挖墙基时" },
    { "t0": 19.94, "t1": 21.20, "text": "铁锹下面突然露出" },
    { "t0": 21.20, "t1": 22.31, "text": "一排平整石板" },
    { "t0": 22.31, "t1": 23.48, "text": "顺着石缝往下照" },
    { "t0": 23.48, "t1": 24.35, "text": "里面黑得没有底" },
    { "t0": 24.35, "t1": 25.41, "text": "四十三天后" },
    { "t0": 25.41, "t1": 26.38, "text": "七间石室" },
    { "t0": 26.38, "t1": 27.31, "text": "一万多件文物" },
    { "t0": 27.31, "t1": 28.25, "text": "和十五个殉人" },
    { "t0": 28.25, "t1": 29.34, "text": "一起重见天日" },
    { "t0": 29.38, "t1": 30.00, "text": "考古队最后认出的墓主" }
  ],
