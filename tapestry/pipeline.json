{
  "version": "2026-11-09",
  "pipeline": "tapestry",
  "style": "bb-video/tapestry",
  "label": "贝叶挂毯 · 刺绣长卷",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "logical": "1 单位 = 1080 高画面下的 1 px；地面线 y=0；画带 -590…0"
  },
  "duration": {
    "default": 30,
    "min": 8,
    "max": 300
  },
  "palette": {
    "linen": "#e2cfa3",
    "ink": "#2c3040",
    "red": "#b0503a",
    "ochre": "#cf9f3e",
    "olive": "#7d8537",
    "sage": "#8ba083",
    "green": "#3e7b6e",
    "blue": "#6a87aa",
    "navy": "#2f4574",
    "brown": "#6b462e",
    "salmon": "#d49076",
    "cream": "#efe5ca",
    "grey": "#9b978a"
  },
  "fonts": [
    "LXGW WenKai (霞鹜文楷)",
    "Cinzel"
  ],
  "motion": {
    "scroll_speed": "120–200 units/s",
    "max_push_zoom": 3.4,
    "entrances": [
      "stitch",
      "lay",
      "grow",
      "fade",
      "none"
    ],
    "cuts": false
  },
  "audio": {
    "bpm": 84,
    "key": "D dorian",
    "lufs": -16,
    "true_peak": -1.5,
    "sample_rate": 48000,
    "channels": 2,
    "voice_lead_in": 0.7,
    "tail": 1.2
  },
  "render": {
    "engine": "Chrome DevTools Protocol, frame by frame",
    "chrome": "CHROME_PATH (Windows: auto-detect Chrome/Edge)",
    "format": "jpeg",
    "jpeg_quality": 92,
    "crf_delivery": 18,
    "preset": "slow",
    "fonts": "jsDelivr @fontsource, cached in ~/.cache/bubble-video/fonts"
  },
  "delivery": {
    "sample": "出稿/<编号>_<选题>/",
    "final": "out/<编号>_<人物>/",
    "files": [
      ".mp4",
      "_封面.png",
      "_字幕.srt",
      "_署名.txt"
    ],
    "qa": "review/qa.json"
  },
  "sample": {
    "name": "阿努纳奇 · 第一段",
    "duration": "30.5 s / 1920×1080 / 30 fps",
    "path": "template/",
    "media_committed": false
  }
}
