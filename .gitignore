# 依赖与虚拟环境
node_modules/
.venv/
venv/

# Python 缓存
__pycache__/
*.py[cod]
.pytest_cache/

# Remotion 与构建缓存
.remotion/
zhidiao/.hyperframes/

# 可重新生成的大体积成片
out/**/*.mp4
projects/*/work/out/*.mp4
zhidiao/renders/
zhidiao/output/
zhidiao/**/*.mp3
zhidiao/**/*.wav
zhidiao/**/*.mp4
zhidiao/**/*.mov
zhidiao/**/*.mkv
zhidiao/**/*.webm

# zhidiao 外部运行时与大模型
zhidiao/vendor/

# tuiyan 成片与可再生成中间产物（发布信息/封面/分镜表保留入库）
tuiyan/content/**/视频输出/
tuiyan/content/**/*.mp4
tuiyan/content/**/*.mov
tuiyan/content/**/*.mkv
tuiyan/content/**/*.webm
tuiyan/content/**/*.mp3
tuiyan/content/**/*.wav
tuiyan/vendor/battlefield-editor/docs/screenshots/
tuiyan/vendor/battlefield-editor/tools/render-out/

# jilupian 成片与可再生成产物（代码与配置入库；配音/模型/字体不入库见 MIGRATION）
jilupian/output/
jilupian/**/成片.mp4
jilupian/config.local.yaml

# jianying 渲染产物
jianying/template/out/
jianying/projects/*/work/out/*.mp4
jianying/projects/*/out/*.mp4

# shouhui 可重新生成的中间产物
shouhui/projects/*/out/stills/
shouhui/projects/*/out/check_*.png
shouhui/projects/*/assets/vid/

# 工作区内部数据和临时文件
.workbuddy/
*.log
Thumbs.db
.DS_Store

# 本地凭据
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
